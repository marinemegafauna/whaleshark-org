---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerRow from '../components/PartnerRow.astro';
import PublicHeader from '../components/PublicHeader.astro';
import { getPageCopy, getSiteCopy } from '../lib/content';
import { renderMarkdownBlocks } from '../lib/content-utils';

const [copy, siteCopy] = await Promise.all([getPageCopy('how-it-works'), getSiteCopy()]);
---
<BaseLayout title={`${copy.title} · ${siteCopy.name}`} description={copy.lede}>
  <PublicHeader active="how" />
  <main class="explainer">
    <header class="intro">
      <span>{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p>{copy.lede}</p>
      <aside class="stage-note">{siteCopy.howItWorksUi.currentStageNotice}</aside>
    </header>
    <aside class="contents card" aria-label={siteCopy.howItWorksUi.contentsLabel}>
      <strong class="mono">{siteCopy.howItWorksUi.contentsLabel}</strong>
      <nav>{copy.sections.map((section, index) => <a href={`#${section.id}`}><span class="mono">{String(index + 1).padStart(2, '0')}</span>{section.heading}</a>)}</nav>
    </aside>
    <article class="story">
      {copy.sections.map((section, index) => <section id={section.id}>
        <span class="section-index mono">{String(index + 1).padStart(2, '0')}</span>
        <div><h2>{section.heading}</h2><div class="body" set:html={renderMarkdownBlocks(section.body)} /></div>
      </section>)}
      <section class="credits-section" id="credits">
        <span class="section-index mono">→</span>
        <div><h2>{siteCopy.howItWorksUi.creditsHeading}</h2><dl class="card">{copy.credits.map((credit) => <div><dt>{credit.label}</dt><dd>{credit.value}</dd></div>)}</dl></div>
      </section>
      <div class="partners"><PartnerRow /></div>
      <a class="button build" href={siteCopy.howItWorksUi.build.href}>{siteCopy.howItWorksUi.build.label}</a>
    </article>
  </main>
</BaseLayout>
<style>
  .explainer { display:grid; gap:34px 52px; grid-template-columns:200px minmax(0,720px); justify-content:center; padding:48px 40px 80px; }
  .intro { grid-column:1/-1; margin-left:252px; max-width:720px; }
  .intro > span { color:var(--accent); font-size:13px; font-weight:500; }
  .intro h1 { font-size:clamp(44px,6vw,72px); font-weight:600; letter-spacing:-.045em; line-height:.98; margin:10px 0 18px; }
  .intro p { color:rgba(21,24,28,.7); font-size:19px; line-height:1.55; margin:0; text-wrap:pretty; }
  .stage-note { background:var(--accent-soft); border-left:2px solid var(--accent); color:var(--muted); font-size:13px; line-height:1.5; margin-top:18px; padding:10px 12px; }
  .contents { align-self:start; padding:14px; position:sticky; top:22px; }
  .contents > strong { color:var(--muted); display:block; font-size:11px; letter-spacing:.06em; margin:3px 8px 8px; text-transform:uppercase; }
  .contents nav { display:flex; flex-direction:column; }
  .contents a { align-items:flex-start; border-radius:7px; display:grid; font-size:12px; gap:8px; grid-template-columns:22px 1fr; line-height:1.3; min-height:44px; padding:8px; }
  .contents a:hover { background:var(--accent-soft); }
  .contents a span { color:var(--accent); font-size:10px; padding-top:2px; }
  .story { display:flex; flex-direction:column; min-width:0; }
  .story > section { display:grid; gap:18px; grid-template-columns:44px minmax(0,1fr); padding:42px 0; scroll-margin-top:24px; }
  .story > section:first-child { padding-top:8px; }
  .story > section:not(:last-of-type) { border-bottom:1px solid var(--line); }
  .section-index { color:var(--accent); font-size:12px; padding-top:6px; }
  h2 { font-size:30px; font-weight:600; letter-spacing:-.03em; line-height:1.1; margin:0 0 16px; text-wrap:balance; }
  .body { color:rgba(21,24,28,.76); font-size:16px; line-height:1.68; }
  .body :global(p) { margin:0 0 16px; }
  .body :global(p:last-child) { margin-bottom:0; }
  .body :global(strong) { color:var(--ink); font-weight:600; }
  .credits-section dl { margin:0; overflow:hidden; }
  .credits-section dl div { display:grid; gap:20px; grid-template-columns:minmax(150px,.7fr) minmax(0,1.3fr); padding:13px 15px; }
  .credits-section dl div:not(:last-child) { border-bottom:1px solid var(--line); }
  .credits-section dt { color:var(--muted); font-size:13px; }
  .credits-section dd { font-size:13px; margin:0; }
  .partners { border-top:1px solid var(--line); margin-top:8px; padding:28px 0; }
  .build { align-self:flex-start; }
  @media (max-width:900px) {
    .explainer { gap:28px; grid-template-columns:minmax(0,720px); padding:34px 32px 64px; }
    .intro { grid-column:1; margin-left:0; }
    .contents { overflow-x:auto; position:static; }
    .contents > strong { margin-bottom:4px; }
    .contents nav { flex-direction:row; min-width:max-content; }
    .contents a { grid-template-columns:auto; min-width:150px; }
    .contents a span { display:block; }
  }
  @media (max-width:560px) {
    .explainer { padding:24px 20px 52px; }
    .intro h1 { font-size:44px; }
    .intro p { font-size:17px; }
    .story > section { gap:10px; grid-template-columns:28px minmax(0,1fr); padding:34px 0; }
    h2 { font-size:26px; }
    .body { font-size:15px; }
    .credits-section dl div { gap:5px; grid-template-columns:1fr; }
    .build { width:100%; }
  }
</style>
