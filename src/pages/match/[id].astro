---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicHeader from '../../components/PublicHeader.astro';
import PublicReportFields from '../../components/PublicReportFields.astro';
import { fillTemplate, getPageCopy, getSiteCopy } from '../../lib/content';
import { dataStore } from '../../lib/runtime';
import { getSpecies } from '../../lib/species';
import { parseStoredPublicObservations, publicObservationHint } from '../../lib/public-observations';
const [copy, siteCopy] = await Promise.all([getPageCopy('match'), getSiteCopy()]);
const submission = await dataStore(Astro.locals).getSubmission(Astro.params.id!);
if (!submission) return Astro.redirect('/match/submission-demo', 302);
const matchPayload = JSON.parse(submission.match_json ?? '[]') as unknown;
const matches = (Array.isArray(matchPayload)
  ? matchPayload
  : matchPayload && typeof matchPayload === 'object' && Array.isArray((matchPayload as { candidates?: unknown[] }).candidates)
    ? (matchPayload as { candidates: unknown[] }).candidates
    : []) as { individualId:string; score:number; site:string; detail:string; image:string }[];
const [best, second] = matches;
const gap = best && second ? best.score - second.score : 0;
const decision = Astro.url.searchParams.get('decision');
const individual = best?.individualId ?? copy.heading.fallbackAnimal;
const species = getSpecies('whale-shark');
const observations = parseStoredPublicObservations(submission.observations_json) ?? {
  observed_date: submission.observed_at,
  site_id: submission.site_id,
  sex: 'unknown',
  life_stage: 'unknown',
  behavior: [],
  living_status: 'alive',
  individual_count: 1,
  injuries: { severity: 'none', regions: [], types: [] },
  submitter_name: submission.photographer_name,
  submitter_email: submission.photographer_email,
  inform_other: [],
};
const observationError = Astro.url.searchParams.get('observation_error');
const observationsSaved = Astro.url.searchParams.get('observations') === 'saved';
const observationSummary = publicObservationHint(observations);
---
<BaseLayout title={fillTemplate(copy.seo.title, { individual: best?.individualId ?? siteCopy.name })} description={copy.seo.description}>
  <PublicHeader active="match" />
  <main class="match-page">
    <section class="photo-column"><div class="card photo-card"><div class="photo"><img src={submission.image_key} width="960" height="540" alt={copy.photo.imageAlt} /><div class="detect-box"></div><span class="detect-label mono">{copy.photo.detectionLabel}</span><span class="file-label mono">{copy.photo.fileLabel}</span></div><div class="photo-meta"><span class="muted">{copy.photo.photographedBy} <b>{submission.photographer_name}</b> · {submission.observed_at} · {submission.site_id}</span><button>{copy.photo.editDetails}</button></div></div><p class="explain muted">{copy.photo.explanation}</p></section>
    <section class="results"><div class="heading"><span>{matches.length ? copy.heading.eyebrow : copy.heading.pendingEyebrow}</span><h1>{matches.length ? fillTemplate(copy.heading.title, { individual }) : copy.heading.pendingTitle}</h1><p>{matches.length ? copy.heading.body : copy.heading.pendingBody}</p></div>
      {decision && <div class="decision" role="status">{decision === 'confirm' ? copy.decisions.confirm : decision === 'none' ? copy.decisions.none : copy.decisions.uncertain}</div>}
      {matches.length ? <div class="card candidates">{matches.map((match,index) => <div class:list={['candidate',{best:index===0}]}><img src={match.image} width="960" height="540" alt={copy.candidates.imageAlt} /><div class="copy"><strong>{match.individualId}</strong><span class="muted">{match.site} · {match.detail}</span></div><div class="score"><b class="mono">{match.score.toFixed(2)}</b><i><i style={`width:${match.score*100}%`}></i></i></div></div>)}<div class="gap"><span class="muted">{copy.candidates.gapLabel} <b class="mono">{gap.toFixed(2)}</b></span><button>{copy.candidates.showMore}</button></div></div> : <p class="card pending-match">{copy.candidates.pending}</p>}
      <form class="card sighting-report" id="sighting" action={`/api/submissions/${submission.id}/observations`} method="post">
        <header><div><h2>{copy.report.heading}</h2><p>{copy.report.help}</p></div>{observationsSaved && <span role="status">{copy.report.saved}</span>}</header>
        {observationError && <p class="report-error" role="alert">{observationError}</p>}
        <PublicReportFields species={species} values={observations} />
        <button class="button" type="submit">{species.public_report.submit_label}</button>
      </form>
      {matches.length > 0 && <><div class="actions"><form action={`/api/submissions/${submission.id}/confirm`} method="post"><input type="hidden" name="decision" value="confirm" /><button class="button" type="submit">{fillTemplate(copy.actions.confirm, { individual })}</button></form><form action={`/api/submissions/${submission.id}/confirm`} method="post"><input type="hidden" name="decision" value="not_sure" /><button class="button secondary" type="submit">{copy.actions.notSure}</button></form><form action={`/api/submissions/${submission.id}/confirm`} method="post"><input type="hidden" name="decision" value="none" /><button class="none muted" type="submit">{copy.actions.none}</button></form></div><p class="muted researcher-note">{fillTemplate(copy.researcherNote, { individual })}</p></>}
      {observationSummary && <aside class="email-preview"><span class="eyebrow">{copy.report.emailPreviewHeading}</span><p>{fillTemplate(copy.report.emailPreviewLabel, { summary: observationSummary })}</p></aside>}
    </section>
  </main>
</BaseLayout>
<style>
  .match-page { align-items: start; display:grid; gap:32px; grid-template-columns:560px 1fr; padding:24px 64px 60px; }.photo-column { display:flex; flex-direction:column; gap:14px; min-width:0; }.photo-card { overflow:hidden; }.photo { height:380px; position:relative; }.photo > img { height:100%; object-fit:cover; width:100%; }.detect-box { border:2px solid var(--accent); border-radius:4px; height:63%; left:17%; position:absolute; top:18%; width:65%; }.detect-label,.file-label { color:var(--accent); font-size:12px; position:absolute; }.detect-label { left:17%; top:12%; }.file-label { bottom:10px; color:rgba(21,24,28,.5); right:12px; }.photo-meta { align-items:center; display:flex; font-size:14px; gap:12px; justify-content:space-between; padding:12px 16px; }.photo-meta b { color:var(--ink); font-weight:400; }.photo-meta button,.gap button,.none { background:none; border:0; cursor:pointer; font-size:14px; padding:0; text-decoration:underline; text-underline-offset:3px; }.explain { font-size:14px; line-height:1.5; margin:0; }.results { display:flex; flex-direction:column; gap:18px; min-width:0; }.heading { display:flex; flex-direction:column; gap:6px; }.heading > span { color:var(--accent); font-size:13px; font-weight:500; }.heading h1 { font-size:40px; font-weight:600; letter-spacing:-.03em; line-height:1.05; margin:0; text-wrap:balance; }.heading p { color:var(--muted); font-size:16px; margin:0; }.pending-match { color:var(--muted); font-size:14px; line-height:1.5; margin:0; padding:16px; }.candidates { display:flex; flex-direction:column; gap:4px; padding:10px; }.candidate { align-items:center; border-radius:10px; display:flex; gap:14px; min-width:0; padding:12px; }.candidate.best { background:var(--accent-soft); border:1px solid rgba(79,70,229,.25); }.candidate img { border-radius:6px; height:68px; object-fit:cover; width:96px; }.copy { display:flex; flex:1; flex-direction:column; gap:2px; min-width:0; }.copy strong { font-size:16px; font-weight:500; }.best .copy strong { font-weight:600; }.copy span { font-size:13px; }.score { align-items:flex-end; display:flex; flex:0 0 auto; flex-direction:column; gap:4px; }.score b { font-size:15px; font-weight:400; }.best .score b { color:var(--accent); font-weight:500; }.score > i { background:rgba(21,24,28,.08); border-radius:2px; display:block; height:4px; overflow:hidden; width:96px; }.score > i > i { background:rgba(21,24,28,.35); display:block; height:100%; }.best .score > i > i { background:var(--accent); }.gap { border-top:1px solid rgba(21,24,28,.08); display:flex; font-size:14px; gap:12px; justify-content:space-between; padding:10px 12px 4px; }.gap b { color:var(--ink); }.sighting-report { display:flex; flex-direction:column; gap:20px; padding:20px; }.sighting-report > header { align-items:flex-start; display:flex; gap:18px; justify-content:space-between; }.sighting-report h2 { font-size:20px; margin:0 0 4px; }.sighting-report header p { color:var(--muted); font-size:13px; line-height:1.45; margin:0; }.sighting-report header span { color:var(--accent); flex:0 0 auto; font-size:12px; }.sighting-report > .button { align-self:flex-start; }.report-error { background:rgba(194,64,12,.08); border-radius:8px; color:var(--warn); font-size:13px; margin:0; padding:9px 11px; }.actions { align-items:center; display:flex; flex-wrap:wrap; gap:12px; }.actions form { margin:0; }.none { font-size:14px; }.researcher-note { font-size:14px; margin:0; }.decision { background:var(--accent-soft); border-radius:8px; color:var(--accent); font-size:14px; padding:10px 12px; }.email-preview { border-left:2px solid var(--accent); padding:4px 0 4px 12px; }.email-preview p { color:var(--muted); font-size:13px; margin:4px 0 0; }
  @media (max-width:1050px) { .match-page { grid-template-columns:1fr; padding-inline:40px; }.photo-column { max-width:680px; } }.results { max-width:760px; }
  @media (max-width:900px) { .actions { align-items:stretch; flex-direction:column; }.actions form,.actions button { width:100%; } }
  @media (max-width:560px) { .match-page { padding:16px 20px 40px; }.photo { height:280px; }.photo-meta { align-items:flex-start; flex-direction:column; }.heading h1 { font-size:34px; }.candidate { gap:10px; padding:10px; }.candidate img { height:52px; width:72px; }.copy span { display:none; }.score > i { width:72px; }.gap,.sighting-report > header { align-items:flex-start; flex-direction:column; }.sighting-report { padding:16px; }.sighting-report > .button { width:100%; } }
</style>
