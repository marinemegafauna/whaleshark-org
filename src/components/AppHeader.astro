---
import { getPageCopy, getSiteCopy } from '../lib/content';
import { listOpenContributionIssues } from '../lib/contribute';
import { isMockAppMode } from '../lib/mode';
import { contributionIssueCache, runtimeValue } from '../lib/runtime';

type NavKey = 'encounters' | 'individuals' | 'scars' | 'matches' | 'exports' | 'practice' | 'contribute' | 'collaboration';
interface Props { active?: NavKey; }
const { active = 'encounters' } = Astro.props;
const [copy, siteCopy] = await Promise.all([getPageCopy('app'), getSiteCopy()]);
const accountName = Astro.locals.session?.username ?? copy.header.accountName;
let contributionCount: number | undefined;
const githubRepo = runtimeValue(Astro.locals, 'GITHUB_REPO');
if (githubRepo) {
  try {
    contributionCount = (await listOpenContributionIssues({
      repo: githubRepo,
      token: runtimeValue(Astro.locals, 'GITHUB_TOKEN'),
      cache: contributionIssueCache(Astro.locals),
    })).length;
  } catch {
    contributionCount = undefined;
  }
}
---
<header class="app-header">
  <a class="brand" href="/app">{siteCopy.name}</a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="app-menu">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14"></path></svg>
    <span>{copy.header.menuLabel}</span>
  </button>
  <nav id="app-menu" aria-label={copy.header.navAriaLabel}>{copy.header.nav.map((item) => item.href
    ? <a class:list={{ active: active === item.key }} href={item.href}>{item.label}{item.key === 'contribute' && contributionCount !== undefined && <small>{contributionCount}</small>}</a>
    : <span>{item.label}</span>)}<div class="account">{!isMockAppMode() && <span class="mono">{copy.header.connectedLabel}</span>}<span>{accountName}</span></div></nav>
</header>
<style>
  .app-header { align-items: center; background: var(--ink); color: #fff; display: grid; font-size: 14px; grid-template-columns: auto minmax(0,1fr) auto; min-height: 52px; padding: 0 24px; }
  .brand { align-items:center; display:flex; font-size:14px; font-weight:600; min-height:44px; }.brand:hover { color: #fff; }
  nav, .account { align-items: center; display: flex; }
  nav { color: rgba(255,255,255,.7); gap: 14px; margin-left: 22px; }.active { color: #fff; }.account { gap: 14px; margin-left: auto; }.mono { font-size: 12px; }
  nav > a { align-items:center; display:flex; gap:5px; white-space:nowrap; }
  nav > a small { align-items:center; background:var(--accent); border-radius:var(--radius-pill); color:#fff; display:inline-flex; font-size:10px; font-weight:600; justify-content:center; min-width:18px; padding:2px 5px; }
  .menu-toggle { align-items:center; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.28); border-radius:var(--radius-pill); color:#fff; cursor:pointer; display:none; gap:7px; justify-content:center; padding:0 14px; }
  @media (max-width: 1100px) {
    .app-header { grid-template-columns:minmax(0,1fr) auto; padding: 8px 20px; }
    .menu-toggle { display:inline-flex; }
    nav { align-items:stretch; border-top:1px solid rgba(255,255,255,.14); flex-direction:column; gap:0; grid-column:1/-1; margin:8px 0 0; padding:8px 0 4px; }
    nav[hidden] { display:none; }
    nav > a, nav > span { align-items:center; border-radius:6px; display:flex; min-height:44px; padding:0 10px; }
    .account { align-items:flex-start; border-top:1px solid rgba(255,255,255,.14); flex-direction:column; gap:4px; margin:6px 0 0; padding:12px 10px 6px; }
  }
</style>
<script>
  import { initDisclosureMenu } from '../lib/disclosure-menu';
  const trigger = document.querySelector<HTMLElement>('.app-header .menu-toggle');
  const menu = document.querySelector<HTMLElement>('#app-menu');
  const mobile = window.matchMedia('(max-width: 1100px)');
  if (trigger && menu) {
    const disclosure = initDisclosureMenu(trigger, menu);
    const sync = () => { if (mobile.matches) disclosure.close(); else menu.hidden = false; };
    mobile.addEventListener('change', sync);
    sync();
  }
</script>
