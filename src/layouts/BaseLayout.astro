---
import '../styles/tokens.css';
import { getSiteCopy } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  app?: boolean;
}

const siteCopy = await getSiteCopy();
const { title = siteCopy.name, description = siteCopy.defaultDescription, app = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class:list={{ app }}><slot /></body>
</html>
<style is:global>
  body.app { background: var(--app-bg); }
</style>
