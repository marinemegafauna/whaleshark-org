---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicHeader from '../../components/PublicHeader.astro';
import { dataStore } from '../../lib/runtime';
const submission = await dataStore(Astro.locals).getSubmission(Astro.params.id!);
if (!submission) return Astro.redirect('/match/submission-demo', 302);
const matches = JSON.parse(submission.match_json ?? '[]') as { individualId:string; score:number; site:string; detail:string; image:string }[];
const [best, second] = matches;
const gap = best && second ? best.score - second.score : 0;
const decision = Astro.url.searchParams.get('decision');
---
<BaseLayout title={`Match results · ${best?.individualId ?? 'whaleshark.org'}`}>
  <PublicHeader active="match" />
  <main class="match-page">
    <section class="photo-column"><div class="card photo-card"><div class="photo"><img src={submission.image_key} alt="Your uploaded whale shark photograph" /><div class="detect-box"></div><span class="detect-label mono">LEFT FLANK · DETECTED</span><span class="file-label mono">YOUR PHOTO · IMG_4471.JPG</span></div><div class="photo-meta"><span class="muted">Photographed by <b>{submission.photographer_name}</b> · {submission.observed_at} · {submission.site_id}</span><button>Edit details</button></div></div><p class="explain muted">We compared the spot pattern inside the box with every left-flank record on Sharkbook. Scores are cosine similarity between MiewID fingerprints; what matters is the gap between the first and second animal, not the absolute number.</p></section>
    <section class="results"><div class="heading"><span>Likely re-sight</span><h1>You met {best?.individualId ?? 'a whale shark'}.</h1><p>First identified at Tofo, Mozambique in 2019. Seen 14 times since, including once at Mafia Island, 1,800 km north.</p></div>
      {decision && <div class="decision" role="status">{decision === 'confirm' ? 'Match sent to the site researchers for confirmation.' : decision === 'none' ? 'Marked as no match; researchers will review the sighting.' : 'Marked as uncertain; researchers will review the candidates.'}</div>}
      <div class="card candidates">{matches.map((match,index) => <div class:list={['candidate',{best:index===0}]}><img src={match.image} alt="Candidate whale shark pattern" /><div class="copy"><strong>{match.individualId}</strong><span class="muted">{match.site} · {match.detail}</span></div><div class="score"><b class="mono">{match.score.toFixed(2)}</b><i><i style={`width:${match.score*100}%`}></i></i></div></div>)}<div class="gap"><span class="muted">Gap to next animal <b class="mono">{gap.toFixed(2)}</b></span><button>Show 10 more</button></div></div>
      <div class="actions"><form action={`/api/submissions/${submission.id}/confirm`} method="post"><input type="hidden" name="decision" value="confirm" /><button class="button" type="submit">Yes, it’s {best?.individualId} — add my sighting</button></form><form action={`/api/submissions/${submission.id}/confirm`} method="post"><input type="hidden" name="decision" value="not_sure" /><button class="button secondary" type="submit">Not sure</button></form><form action={`/api/submissions/${submission.id}/confirm`} method="post"><input type="hidden" name="decision" value="none" /><button class="none muted" type="submit">None of these</button></form></div>
      <p class="muted researcher-note">Researchers at Tofo will confirm the match. You’ll get an email when your sighting is added to {best?.individualId}’s history.</p>
    </section>
  </main>
</BaseLayout>
<style>
  .match-page { align-items: start; display:grid; gap:32px; grid-template-columns:560px 1fr; padding:24px 64px 60px; }.photo-column { display:flex; flex-direction:column; gap:14px; }.photo-card { overflow:hidden; }.photo { height:380px; position:relative; }.photo > img { height:100%; object-fit:cover; width:100%; }.detect-box { border:2px solid var(--accent); border-radius:4px; height:63%; left:17%; position:absolute; top:18%; width:65%; }.detect-label,.file-label { color:var(--accent); font-size:11px; position:absolute; }.detect-label { left:17%; top:12%; }.file-label { bottom:10px; color:rgba(21,24,28,.5); right:12px; }.photo-meta { align-items:center; display:flex; font-size:13px; justify-content:space-between; padding:12px 16px; }.photo-meta b { color:var(--ink); font-weight:400; }.photo-meta button,.gap button,.none { background:none; border:0; cursor:pointer; font-size:13px; padding:0; text-decoration:underline; text-underline-offset:3px; }.explain { font-size:13px; line-height:1.5; margin:0; }.results { display:flex; flex-direction:column; gap:18px; }.heading { display:flex; flex-direction:column; gap:6px; }.heading > span { color:var(--accent); font-size:13px; font-weight:500; }.heading h1 { font-size:40px; font-weight:600; letter-spacing:-.03em; line-height:1.05; margin:0; }.heading p { color:var(--muted); font-size:16px; margin:0; }.candidates { display:flex; flex-direction:column; gap:4px; padding:10px; }.candidate { align-items:center; border-radius:10px; display:flex; gap:14px; padding:12px; }.candidate.best { background:var(--accent-soft); border:1px solid rgba(79,70,229,.25); }.candidate img { border-radius:6px; height:68px; object-fit:cover; width:96px; }.copy { display:flex; flex:1; flex-direction:column; gap:2px; }.copy strong { font-size:16px; font-weight:500; }.best .copy strong { font-weight:600; }.copy span { font-size:13px; }.score { align-items:flex-end; display:flex; flex-direction:column; gap:4px; }.score b { font-size:15px; font-weight:400; }.best .score b { color:var(--accent); font-weight:500; }.score > i { background:rgba(21,24,28,.08); border-radius:2px; display:block; height:4px; overflow:hidden; width:96px; }.score > i > i { background:rgba(21,24,28,.35); display:block; height:100%; }.best .score > i > i { background:var(--accent); }.gap { border-top:1px solid rgba(21,24,28,.08); display:flex; font-size:13px; justify-content:space-between; padding:10px 12px 4px; }.gap b { color:var(--ink); }.actions { align-items:center; display:flex; flex-wrap:wrap; gap:12px; }.actions form { margin:0; }.none { font-size:13px; }.researcher-note { font-size:13px; margin:0; }.decision { background:var(--accent-soft); border-radius:8px; color:var(--accent); font-size:13px; padding:10px 12px; }
  @media (max-width:1050px) { .match-page { grid-template-columns:1fr; padding-inline:40px; }.photo-column { max-width:680px; } }.results { max-width:760px; }
  @media (max-width:600px) { .match-page { padding:16px 20px 40px; }.photo { height:280px; }.heading h1 { font-size:34px; }.candidate img { height:52px; width:72px; }.copy span { display:none; }.actions { align-items:stretch; flex-direction:column; }.actions .button { width:100%; } }
</style>
