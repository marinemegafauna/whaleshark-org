# Wildbook / Sharkbook service configuration
WILDBOOK_BASE_URL=https://www.sharkbook.ai
WILDBOOK_SERVICE_USER=
WILDBOOK_SERVICE_PASSWORD=

# Generate a long random value for production sessions.
SESSION_SECRET=change-me

# Public writes remain local until Wild Me approves the service-account flow.
PUBLIC_WRITE=dry-run

# Development defaults: browse every screen without credentials or network calls.
MOCK=1
