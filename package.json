{
  "name": "whaleshark-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "astro build && wrangler deploy",
    "db:create": "wrangler d1 create whaleshark-org",
    "db:migrate": "wrangler d1 migrations apply whaleshark-org --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "astro": "^7.2.4",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22"
  }
}
