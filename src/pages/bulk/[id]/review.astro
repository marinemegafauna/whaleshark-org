---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PublicHeader from '../../../components/PublicHeader.astro';
import { groupBatchItems } from '../../../lib/batch-groups';
import { dataStore } from '../../../lib/runtime';

const store = dataStore(Astro.locals);
const batch = await store.getBatch(Astro.params.id!);
if (!batch) return Astro.redirect('/bulk', 302);
const items = await store.listBatchItems(batch.id);
const groups = groupBatchItems(items);
const noShark = items.filter((item) => item.status === 'no_shark').length;
const errors = items.filter((item) => item.status === 'error').length;
const submitted = Astro.url.searchParams.get('submitted') === '1' || batch.status === 'submitted';
function parsed(item: typeof items[number]) { try { return JSON.parse(item.match_json ?? '{}') as Record<string, any>; } catch { return {}; } }
---
<BaseLayout title={`Review ${batch.photographer_name}'s batch · whaleshark.org`}>
  <PublicHeader active="match" />
  <main class="review-page">
    <div class="review-heading"><span>Bulk upload · review</span><h1>{submitted ? 'Batch sent for researcher review.' : `${groups.length} proposed animals from ${items.length} photos.`}</h1><p>{submitted ? 'The site team can now check each grouping before any sighting joins Sharkbook.' : 'Confirm the photos that belong together. Nothing is added to Sharkbook until this review is submitted and a site researcher checks it.'}</p></div>
    {submitted && <div class="card submitted" role="status"><strong>Review recorded</strong><span>{batch.photographer_name} · {batch.observed_at} · {batch.site_id}</span><a href="/">Back to whaleshark.org →</a></div>}
    {!submitted && <form action={`/api/batches/${batch.id}/submit`} method="post" class="review-form">
      <div class="groups">
        {groups.map((group) => { const best=parsed(group.items[0]!); const candidate=best.candidates?.[0]; return <fieldset class="card group-card">
          <legend><span>{group.kind === 'known' ? 'Proposed re-sight' : 'Proposed new animal'}</span><strong>{group.label}</strong><small>{group.items.length} photo{group.items.length === 1 ? '' : 's'}{candidate ? ` · best score ${Number(candidate.score).toFixed(2)}` : ` · within-batch score ${group.bestScore.toFixed(2)}`}</small></legend>
          <div class="group-photos">{group.items.map((item) => { const match=parsed(item); const bbox=Array.isArray(match.bbox)?match.bbox:null; return <figure><div><img src={item.image_key} alt={`Uploaded photo ${item.filename}`} />{bbox && <i style={`left:${bbox[0]*100}%;top:${bbox[1]*100}%;width:${bbox[2]*100}%;height:${bbox[3]*100}%`}></i>}</div><figcaption class="mono">{item.filename}</figcaption></figure> })}</div>
          {candidate && <div class="candidate"><img src={group.items[0]!.image_key} alt={`${candidate.individualId} comparison pattern`} /><span><b>{candidate.individualId}</b><small>Best proposed Sharkbook individual</small></span><strong class="mono">{Number(candidate.score).toFixed(2)}</strong></div>}
          <div class="decisions" role="radiogroup" aria-label={`Decision for ${group.label}`}>
            <label><input type="radio" name={`decision:${group.key}`} value="confirm" checked /><span>{group.kind === 'known' ? `Yes, this is ${group.label}` : 'Yes, group as one new animal'}</span></label>
            <label><input type="radio" name={`decision:${group.key}`} value="not_sure" /><span>Not sure</span></label>
            <label><input type="radio" name={`decision:${group.key}`} value="none" /><span>None of these</span></label>
          </div>
        </fieldset> })}
      </div>
      <aside class="card submit-card"><h2>Submit this batch</h2><dl><div><dt>Site</dt><dd>{batch.site_id}</dd></div><div><dt>Date</dt><dd>{batch.observed_at}</dd></div><div><dt>Photographer</dt><dd>{batch.photographer_name}</dd></div><div><dt>Animal groups</dt><dd>{groups.length}</dd></div><div><dt>No shark found</dt><dd>{noShark}</dd></div>{errors > 0 && <div><dt>Needs upload help</dt><dd>{errors}</dd></div>}</dl><button class="button" type="submit">Submit batch</button><a href={`/bulk?batch=${batch.id}`}>← Back to photos</a><p>Submitting records your choices. Site researchers still confirm every match before publication.</p></aside>
    </form>}
  </main>
</BaseLayout>
<style>
  .review-page { display:flex; flex-direction:column; gap:22px; padding:12px 64px 56px; }.review-heading { display:flex; flex-direction:column; gap:6px; max-width:900px; }.review-heading > span { color:var(--accent); font-size:13px; font-weight:500; }.review-heading h1 { font-size:40px; font-weight:600; letter-spacing:-.03em; line-height:1.05; margin:0; }.review-heading p { color:var(--muted); font-size:15px; line-height:1.5; margin:0; }.review-form { align-items:start; display:grid; gap:28px; grid-template-columns:minmax(0,1fr) 320px; }.groups { display:flex; flex-direction:column; gap:18px; }.group-card { margin:0; min-width:0; padding:18px; }.group-card legend { display:flex; flex-direction:column; gap:2px; padding:0 8px; }.group-card legend span { color:var(--accent); font-size:12px; font-weight:500; }.group-card legend strong { font-size:20px; font-weight:600; }.group-card legend small { color:var(--muted); font-size:12px; }.group-photos { display:grid; gap:10px; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); }.group-photos figure { margin:0; min-width:0; }.group-photos figure > div { background:#e6e9ed; border-radius:8px; height:112px; overflow:hidden; position:relative; }.group-photos img { height:100%; object-fit:cover; width:100%; }.group-photos i { border:1.5px solid var(--accent); border-radius:3px; position:absolute; }.group-photos figcaption { color:var(--muted); font-size:10px; overflow:hidden; padding-top:5px; text-overflow:ellipsis; white-space:nowrap; }.candidate { align-items:center; background:var(--accent-soft); border:1px solid rgba(79,70,229,.2); border-radius:10px; display:flex; gap:12px; margin-top:14px; padding:10px; }.candidate img { border-radius:6px; height:52px; object-fit:cover; width:72px; }.candidate span { display:flex; flex:1; flex-direction:column; }.candidate b { font-size:15px; }.candidate small { color:var(--muted); font-size:12px; }.candidate > strong { color:var(--accent); font-size:14px; }.decisions { border-top:1px solid var(--line); display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; padding-top:14px; }.decisions label { cursor:pointer; min-height:44px; position:relative; }.decisions input { opacity:0; position:absolute; }.decisions span { align-items:center; border:1px solid var(--line-strong); border-radius:var(--radius-pill); display:flex; font-size:13px; height:44px; padding:0 16px; }.decisions input:checked + span { background:var(--ink); border-color:var(--ink); color:#fff; }.decisions input:focus-visible + span { outline:3px solid rgba(79,70,229,.35); outline-offset:2px; }.submit-card { display:flex; flex-direction:column; gap:14px; padding:18px; position:sticky; top:20px; }.submit-card h2 { font-size:16px; margin:0; }.submit-card dl { display:flex; flex-direction:column; gap:8px; margin:0; }.submit-card dl div { display:flex; font-size:13px; gap:12px; justify-content:space-between; }.submit-card dt { color:var(--muted); }.submit-card dd { font-weight:500; margin:0; text-align:right; }.submit-card .button { min-height:44px; width:100%; }.submit-card > a { font-size:13px; text-align:center; text-decoration:underline; text-underline-offset:3px; }.submit-card p { color:var(--muted); font-size:12px; line-height:1.5; margin:0; }.submitted { align-items:flex-start; display:flex; flex-direction:column; gap:6px; max-width:620px; padding:20px; }.submitted strong { color:var(--accent); }.submitted span { color:var(--muted); font-size:13px; }.submitted a { font-size:13px; font-weight:600; margin-top:8px; }
  @media (max-width:900px) { .review-page { padding-inline:40px; }.review-form { grid-template-columns:1fr; }.submit-card { position:static; width:100%; } }
  @media (max-width:600px) { .review-page { padding:8px 20px 40px; }.review-heading h1 { font-size:32px; }.group-card { padding:14px; }.decisions { align-items:stretch; flex-direction:column; }.decisions label,.decisions span { width:100%; } }
</style>
