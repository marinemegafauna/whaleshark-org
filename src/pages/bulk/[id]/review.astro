---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PublicHeader from '../../../components/PublicHeader.astro';
import PublicReportFields from '../../../components/PublicReportFields.astro';
import ProvenanceChip from '../../../components/ProvenanceChip.astro';
import { groupBatchItems } from '../../../lib/batch-groups';
import { fillTemplate, getPageCopy } from '../../../lib/content';
import { dataStore } from '../../../lib/runtime';
import { getSpecies } from '../../../lib/species';
import { parseStoredPublicObservations } from '../../../lib/public-observations';
import { parseProvenanceResult } from '../../../lib/provenance';

const [bulkCopy, provenanceCopy] = await Promise.all([getPageCopy('bulk'), getPageCopy('provenance')]);
const copy = bulkCopy.review;
const store = dataStore(Astro.locals);
const batch = await store.getBatch(Astro.params.id!);
if (!batch) return Astro.redirect('/bulk', 302);
const items = await store.listBatchItems(batch.id);
const groups = groupBatchItems(items);
const noShark = items.filter((item) => item.status === 'no_shark').length;
const errors = items.filter((item) => item.status === 'error').length;
const submitted = Astro.url.searchParams.get('submitted') === '1' || batch.status === 'submitted';
const species = getSpecies('whale-shark');
const animalFieldIds = ['sex','life_stage','length','behavior','living_status','injury_severity','injury_regions','injury_types','injury_description'];
const observationError = Astro.url.searchParams.get('observation_error') === '1';
const flaggedCount = items.filter((item) => (parseProvenanceResult(item.provenance_json)?.score ?? 0) >= 1).length;
function parsed(item: typeof items[number]) { try { return JSON.parse(item.match_json ?? '{}') as Record<string, any>; } catch { return {}; } }
---
<BaseLayout title={fillTemplate(copy.seoTitle, { photographer: batch.photographer_name })}>
  <PublicHeader active="match" />
  <main class="review-page">
    <div class="review-heading"><span>{copy.eyebrow}</span><h1>{submitted ? copy.headingSubmitted : fillTemplate(copy.headingPending, { groups: groups.length, photos: items.length })}</h1><p>{submitted ? copy.introSubmitted : copy.introPending}</p></div>
    {observationError && <p class="observation-error" role="alert">{copy.missingAnimalFields}</p>}
    {submitted && <div class="card submitted" role="status"><strong>{copy.recordedLabel}</strong><span>{batch.photographer_name} · {batch.observed_at} · {batch.site_id}</span><a href="/">{copy.backHome}</a></div>}
    {!submitted && <form action={`/api/batches/${batch.id}/submit`} method="post" class="review-form">
      <div class="groups">
        {groups.map((group) => { const best=parsed(group.items[0]!); const candidate=best.candidates?.[0]; return <fieldset class="card group-card">
          <legend><span>{group.kind === 'known' ? copy.knownLabel : copy.newLabel}</span><strong>{group.label}</strong><small>{fillTemplate(group.items.length === 1 ? copy.photoCountSingular : copy.photoCountPlural, { count: group.items.length })}{candidate ? fillTemplate(copy.bestScore, { score: Number(candidate.score).toFixed(2) }) : fillTemplate(copy.withinBatchScore, { score: group.bestScore.toFixed(2) })}</small></legend>
          <div class="group-photos">{group.items.map((item) => { const match=parsed(item); const bbox=Array.isArray(match.bbox)?match.bbox:null; const provenance=parseProvenanceResult(item.provenance_json); return <figure><div><img src={item.image_key} width="960" height="540" alt={fillTemplate(copy.uploadedPhotoAlt, { filename: item.filename })} />{bbox && <i style={`left:${bbox[0]*100}%;top:${bbox[1]*100}%;width:${bbox[2]*100}%;height:${bbox[3]*100}%`}></i>}</div><figcaption class="mono">{item.filename}</figcaption><ProvenanceChip result={provenance} /></figure> })}</div>
          {candidate && <div class="candidate"><img src={group.items[0]!.image_key} width="960" height="540" alt={fillTemplate(copy.candidateAlt, { individual: candidate.individualId })} /><span><b>{candidate.individualId}</b><small>{copy.candidateHelp}</small></span><strong class="mono">{Number(candidate.score).toFixed(2)}</strong></div>}
          <section class="animal-observations"><h3>{copy.perAnimalHeading}</h3><p>{copy.perAnimalHelp}</p><PublicReportFields species={species} groups={['about_shark','injuries']} fieldIds={animalFieldIds} values={parseStoredPublicObservations(group.items[0]!.observations_json)} prefix={`observation:${group.key}:`} compact /></section>
          <div class="decisions" role="radiogroup" aria-label={fillTemplate(copy.decisionAria, { group: group.label })}>
            <label><input type="radio" name={`decision:${group.key}`} value="confirm" checked /><span>{group.kind === 'known' ? fillTemplate(copy.confirmKnown, { group: group.label }) : copy.confirmNew}</span></label>
            <label><input type="radio" name={`decision:${group.key}`} value="not_sure" /><span>{copy.notSure}</span></label>
            <label><input type="radio" name={`decision:${group.key}`} value="none" /><span>{copy.none}</span></label>
          </div>
        </fieldset> })}
      </div>
      <aside class="card submit-card"><h2>{copy.submitHeading}</h2>{flaggedCount > 0 && <p class="provenance-line">{fillTemplate(provenanceCopy.batchFlagged, { flagged: flaggedCount, total: items.length })}</p>}<dl><div><dt>{copy.summaryLabels.site}</dt><dd>{batch.site_id}</dd></div><div><dt>{copy.summaryLabels.date}</dt><dd>{batch.observed_at}</dd></div><div><dt>{copy.summaryLabels.photographer}</dt><dd>{batch.photographer_name}</dd></div><div><dt>{copy.summaryLabels.animalGroups}</dt><dd>{groups.length}</dd></div><div><dt>{copy.summaryLabels.noShark}</dt><dd>{noShark}</dd></div>{errors > 0 && <div><dt>{copy.summaryLabels.needsHelp}</dt><dd>{errors}</dd></div>}</dl><div class="submit-action"><button class="button" type="submit">{copy.submitButton}</button></div><a href={`/bulk?batch=${batch.id}`}>{copy.backToPhotos}</a><p>{copy.submitHelp}</p></aside>
    </form>}
  </main>
</BaseLayout>
<style>
  .review-page { display:flex; flex-direction:column; gap:22px; padding:12px 64px 56px; }.review-heading { display:flex; flex-direction:column; gap:6px; max-width:900px; }.review-heading > span { color:var(--accent); font-size:13px; font-weight:500; }.review-heading h1 { font-size:40px; font-weight:600; letter-spacing:-.03em; line-height:1.05; margin:0; text-wrap:balance; }.review-heading p { color:var(--muted); font-size:15px; line-height:1.5; margin:0; }.review-form { align-items:start; display:grid; gap:28px; grid-template-columns:minmax(0,1fr) 320px; }.groups { display:flex; flex-direction:column; gap:18px; min-width:0; }.group-card { margin:0; min-width:0; padding:18px; }.group-card legend { display:flex; flex-direction:column; gap:2px; max-width:100%; padding:0 8px; }.group-card legend span { color:var(--accent); font-size:12px; font-weight:500; }.group-card legend strong { font-size:20px; font-weight:600; }.group-card legend small { color:var(--muted); font-size:12px; }.group-photos { display:grid; gap:10px; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); }.group-photos figure { margin:0; min-width:0; }.group-photos figure > div { background:#e6e9ed; border-radius:8px; height:112px; overflow:hidden; position:relative; }.group-photos img { height:100%; object-fit:cover; width:100%; }.group-photos i { border:1.5px solid var(--accent); border-radius:3px; position:absolute; }.group-photos figcaption { color:var(--muted); font-size:12px; overflow:hidden; padding-top:5px; text-overflow:ellipsis; white-space:nowrap; }.candidate { align-items:center; background:var(--accent-soft); border:1px solid rgba(79,70,229,.2); border-radius:10px; display:flex; gap:12px; margin-top:14px; padding:10px; }.candidate img { border-radius:6px; height:52px; object-fit:cover; width:72px; }.candidate span { display:flex; flex:1; flex-direction:column; min-width:0; }.candidate b { font-size:15px; }.candidate small { color:var(--muted); font-size:12px; }.candidate > strong { color:var(--accent); font-size:14px; }.animal-observations { border-top:1px solid var(--line); margin-top:16px; padding-top:16px; }.animal-observations h3 { font-size:15px; margin:0; }.animal-observations > p { color:var(--muted); font-size:12px; margin:4px 0 14px; }.decisions { border-top:1px solid var(--line); display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; padding-top:14px; }.decisions label { cursor:pointer; min-height:44px; position:relative; }.decisions input { opacity:0; position:absolute; }.decisions span { align-items:center; border:1px solid var(--line-strong); border-radius:var(--radius-pill); display:flex; font-size:14px; height:44px; padding:0 16px; }.decisions input:checked + span { background:var(--ink); border-color:var(--ink); color:#fff; }.decisions input:focus-visible + span { outline:3px solid rgba(79,70,229,.35); outline-offset:2px; }.submit-card { display:flex; flex-direction:column; gap:14px; padding:18px; position:sticky; top:20px; }.submit-card h2 { font-size:16px; margin:0; }.submit-card dl { display:flex; flex-direction:column; gap:8px; margin:0; }.submit-card dl div { display:flex; font-size:14px; gap:12px; justify-content:space-between; }.submit-card dt { color:var(--muted); }.submit-card dd { font-weight:500; margin:0; text-align:right; }.submit-action,.submit-card .button { width:100%; }.submit-card > a { align-items:center; display:flex; font-size:14px; justify-content:center; min-height:44px; text-align:center; text-decoration:underline; text-underline-offset:3px; }.submit-card p { color:var(--muted); font-size:12px; line-height:1.5; margin:0; }.submitted { align-items:flex-start; display:flex; flex-direction:column; gap:6px; max-width:620px; padding:20px; }.submitted strong { color:var(--accent); }.submitted span { color:var(--muted); font-size:14px; }.submitted a { align-items:center; display:inline-flex; font-size:14px; font-weight:600; margin-top:8px; min-height:44px; }
  .observation-error { background:rgba(194,64,12,.08); border-radius:8px; color:var(--warn); font-size:14px; margin:0; padding:10px 12px; }
  .provenance-line { background:#fff3cd; border-left:2px solid #b7791f; color:#6b4700 !important; font-weight:500; padding:9px 10px; }
  @media (max-width:900px) { .review-page { padding-inline:40px; }.review-form { grid-template-columns:1fr; }.submit-card { position:static; width:100%; } }
  @media (max-width:560px) { .review-page { padding:8px 20px calc(40px + env(safe-area-inset-bottom)); }.review-heading h1 { font-size:32px; }.group-card { padding:14px; }.decisions { align-items:stretch; flex-direction:column; }.decisions label,.decisions span { width:100%; }.submit-action { background:var(--panel); bottom:0; margin-inline:-18px; padding:10px 18px max(10px,env(safe-area-inset-bottom)); position:sticky; z-index:2; } }
</style>
