---
import AppHeader from '../../../../components/AppHeader.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { mockEncounters, mockScarFirstSeenLabels, type MockEncounter } from '../../../../mock/data';
import { appDataStore } from '../../../../lib/runtime';
import { getSpecies } from '../../../../lib/species';
import { isMockAppMode } from '../../../../lib/mode';
import { getEncounter, isWildbookUnauthorized, mapEncounterHit } from '../../../../lib/wildbook';
import { fillTemplate, getPageCopy, getSiteCopy } from '../../../../lib/content';

const [pageCopy, siteCopy] = await Promise.all([getPageCopy('app'), getSiteCopy()]);
const copy = pageCopy.scar;
const requestedSiteId = Astro.url.searchParams.get('site') ?? 'tofo';
const requestedSiteLabel = siteCopy.researchSites.find((site) => site.id === requestedSiteId)?.label ?? requestedSiteId;
let encounter: MockEncounter;
if (isMockAppMode()) {
  encounter = mockEncounters.find((candidate) => candidate.id === Astro.params.id) ?? mockEncounters[0]!;
} else {
  try {
    encounter = mapEncounterHit(await getEncounter(Astro.locals.session!.wildbook_cookie, Astro.params.id!), requestedSiteId);
  } catch (error) {
    if (!isWildbookUnauthorized(error)) throw error;
    Astro.cookies.delete('whaleshark_session', { path: '/' });
    return Astro.redirect('/signin?error=expired', 303);
  }
}
const species = getSpecies('whale-shark');
const store = appDataStore(Astro.locals);
const scars = await store.listScarRecords({ encounterId: encounter.id });
const scarRows = scars.map((scar) => ({ ...scar, fields: JSON.parse(scar.fields_json) as Record<string, string> }));
const optionLabels = new Map(species.fields.flatMap((field) => (field.options ?? []).map((option) => [`${field.id}:${option.id}`, option.label] as const)));
const defaults: Record<string,string> = { body_region:'flank', type:'abrasion', severity:'minor', freshness:'fresh', likely_cause:'unknown', confidence:'certain' };
const saved = Astro.url.searchParams.has('saved');
const individualLabel = encounter.individualId ?? `Unnamed shark · ${(encounter.individualUuid ?? encounter.id).slice(0, 8)}`;
const primaryView = encounter.photos.endsWith('R') && !encounter.photos.includes('L') ? 'right' : 'left';
const firstSeenLabel = (scar: typeof scars[number]) => scar.first_seen_encounter_id === encounter.id
  ? copy.thisEncounter
  : mockScarFirstSeenLabels[scar.first_seen_encounter_id ?? ''] ?? scar.first_seen_encounter_id ?? '—';
---
<BaseLayout app title={fillTemplate(pageCopy.seo.scarTitle, { individual: encounter.individualId ?? encounter.id })} description={pageCopy.seo.scarDescription}>
  <AppHeader />
  <main class="scar-page" data-placement-pending={copy.placementPending} data-placement-done={copy.placementDone}>
    <header class="encounter-heading"><div><p class="muted">{fillTemplate(copy.breadcrumb, { site: requestedSiteLabel.split(',')[0]!, encounter: encounter.id })}</p><h1>{fillTemplate(copy.heading, { individual: individualLabel, date: encounter.date })}</h1></div><div class="metadata muted"><span>{encounter.photographer}</span><span>{fillTemplate(copy.metadata, { sex: encounter.sex, size: encounter.size, sightings: encounter.sightings })}</span><span class="state-chip">{encounter.state}</span><span class="mono">{fillTemplate(copy.schemaLabel, { version: species.version })}</span><a href={`https://www.sharkbook.ai/encounters/encounter.jsp?number=${encounter.id}`}>{copy.openSharkbook}</a></div></header>
    {saved && <div class="saved" role="status">{copy.saved}</div>}
    <div class="entry-grid"><section class="photo-and-records"><div class="panel photo-panel"><div class="photo-tabs"><span>{primaryView === 'left' ? <b>{copy.photoTabs.left}</b> : <span class="muted">{copy.photoTabs.left}</span>}{primaryView === 'right' ? <b>{copy.photoTabs.right}</b> : <span class="muted">{copy.photoTabs.right}</span>}<span class="muted">{copy.photoTabs.dorsal}</span><span class="muted">{fillTemplate(copy.photoTabs.allPhotos, { count: encounter.photos.split(' ')[0]! })}</span></span><span class="muted">{copy.photoTabs.help}</span></div><div class="photo" id="scar-photo"><img src={encounter.image} width="960" height="540" alt={fillTemplate(copy.imageAlt, { individual: individualLabel.toLowerCase() })} />{encounter.box && <span class="detection-box" aria-hidden="true" style={`left:${encounter.box[0]*100}%;top:${encounter.box[1]*100}%;width:${encounter.box[2]*100}%;height:${encounter.box[3]*100}%`}></span>}{scars.map((scar,index) => <span class:list={['marker',{major:JSON.parse(scar.fields_json).severity==='major'}]} style={`left:${(scar.x??0)*100}%;top:${(scar.y??0)*100}%`}>{index+1}</span>)}<span class="marker draft" id="draft-marker" hidden>{scars.length+1}</span><span class="image-label mono">{encounter.imageFilename} · {encounter.date.toUpperCase()} · {encounter.photographer.toUpperCase()}</span></div></div>
      <div class="panel scar-table"><div class="scar-head">{copy.tableHeaders.map((header) => <span>{header}</span>)}</div>{scarRows.map((scar,index) => { const fields=scar.fields; return <div class="scar-row"><b class:list={{warn:fields.severity==='major'}}>{index+1}</b><span>{optionLabels.get(`body_region:${fields.body_region}`)}</span><span>{optionLabels.get(`type:${fields.type}`)}</span><b class:list={{warn:fields.severity==='major'}}>{optionLabels.get(`severity:${fields.severity}`)}</b><span>{optionLabels.get(`freshness:${fields.freshness}`)}</span><span>{optionLabels.get(`likely_cause:${fields.likely_cause}`)}</span><span class="muted">{firstSeenLabel(scar)}</span></div>})}<div class="scar-row draft-row"><b>{scars.length+1}</b><span class="muted draft-copy">{copy.newScarHelp}</span></div></div>
      <section class="scar-cards" aria-label={copy.cardsAriaLabel}>{scarRows.map((scar,index) => { const fields=scar.fields; return <article class="panel scar-card"><header><strong class:list={{warn:fields.severity==='major'}}>{fillTemplate(copy.scarLabel, { number: index + 1 })}</strong><span>{optionLabels.get(`severity:${fields.severity}`)}</span></header><dl><div><dt>{copy.tableHeaders[1]}</dt><dd>{optionLabels.get(`body_region:${fields.body_region}`)}</dd></div><div><dt>{copy.tableHeaders[2]}</dt><dd>{optionLabels.get(`type:${fields.type}`)}</dd></div><div><dt>{copy.tableHeaders[4]}</dt><dd>{optionLabels.get(`freshness:${fields.freshness}`)}</dd></div><div><dt>{copy.tableHeaders[5]}</dt><dd>{optionLabels.get(`likely_cause:${fields.likely_cause}`)}</dd></div><div><dt>{copy.tableHeaders[6]}</dt><dd>{firstSeenLabel(scar)}</dd></div></dl></article>})}<article class="panel scar-card draft-card"><header><strong>{fillTemplate(copy.scarLabel, { number: scars.length + 1 })}</strong><span>{copy.draftLabel}</span></header><p>{copy.draftHelp}</p></article></section>
      <div class="record-actions"><p class="muted">{copy.recordHelp}</p><div><form action="/api/review" method="post"><input type="hidden" name="encounter_id" value={encounter.id}/><input type="hidden" name="site_id" value={encounter.siteId}/><input type="hidden" name="status" value="no_new_scars"/><button class="small-button secondary">{copy.noNewScars}</button></form><form action="/api/review" method="post" id="finish-record"><input type="hidden" name="encounter_id" value={encounter.id}/><input type="hidden" name="site_id" value={encounter.siteId}/><input type="hidden" name="status" value="recorded"/><button class="small-button finish">{copy.finishNext}</button></form></div></div></section>
      <form class="panel scar-form" action="/api/scars" method="post" id="scar-form"><input type="hidden" name="encounter_id" value={encounter.id}/><input type="hidden" name="individual_id" value={encounter.individualId ?? ''}/><input type="hidden" name="individual_uuid" value={encounter.individualUuid ?? ''}/><input type="hidden" name="species_id" value={species.id}/><input type="hidden" name="schema_version" value={species.version}/><input type="hidden" name="site_id" value={encounter.siteId}/><input type="hidden" name="photo_asset_id" value={encounter.image}/><input type="hidden" name="x" id="scar-x" value="0.5"/><input type="hidden" name="y" id="scar-y" value="0.7"/>
        <div class="form-heading"><strong>{fillTemplate(copy.scarLabel, { number: scars.length + 1 })}</strong><span class="muted" id="placed-status">{copy.placementPending}</span></div>
        {species.fields.map((field) => <fieldset title={field.help}><legend>{field.label}{field.help && <span class="muted"> · {field.help}</span>}</legend>{field.type==='text' ? <textarea name={`field_${field.id}`} placeholder={copy.notesPlaceholder}></textarea> : <div class="chips">{field.options!.map((option) => <label class:list={['chip',{emphasis:option.emphasis}]} title={option.help}><input type="radio" name={`field_${field.id}`} value={option.id} required={field.required} checked={(field.default ?? defaults[field.id])===option.id}/>{option.swatch && <i style={`background:${option.swatch}`}></i>}<span>{option.label}{option.emphasis && option.help ? ` — ${option.help}` : ''}</span></label>)}</div>}</fieldset>)}
        <div class="form-actions"><span class="muted">{copy.linkedLabel}</span><div><button class="small-button secondary" id="discard" type="reset">{copy.discard}</button><button class="small-button save" type="submit">{copy.save}</button></div></div>
      </form></div>
    <div class="mobile-actions"><button class="small-button save" type="submit" form="scar-form">{copy.save}</button><button class="small-button finish" type="submit" form="finish-record">{copy.finish}</button></div>
  </main>
</BaseLayout>
<style>
  .scar-page { display:flex; flex-direction:column; gap:12px; padding:14px 24px 24px; }.encounter-heading { align-items:flex-end; display:flex; gap:20px; justify-content:space-between; }.encounter-heading p { font-size:12px; margin:0 0 2px; }.encounter-heading h1 { font-size:22px; font-weight:600; letter-spacing:-.02em; margin:0; text-wrap:balance; }.metadata { align-items:center; display:flex; font-size:12px; gap:14px; }.metadata a { align-items:center; display:flex; min-height:44px; text-decoration:underline; text-underline-offset:3px; }.state-chip { background:rgba(21,24,28,.06); border-radius:var(--radius-pill); color:var(--muted); padding:3px 8px; text-transform:capitalize; }.saved { background:var(--accent-soft); border-radius:8px; color:var(--accent); font-size:14px; padding:9px 12px; }.entry-grid { align-items:start; display:grid; gap:12px; grid-template-columns:minmax(0,1fr) 420px; }.photo-and-records { display:flex; flex-direction:column; gap:12px; min-width:0; }.photo-panel { overflow:hidden; }.photo-tabs { border-bottom:1px solid rgba(21,24,28,.08); display:flex; font-size:12px; gap:12px; justify-content:space-between; padding:9px 14px; }.photo-tabs > span:first-child { display:flex; flex-wrap:wrap; gap:14px; }.photo { overflow:hidden; position:relative; }.photo > img { display:block; height:auto; width:100%; }.detection-box { border:2px solid rgba(79,70,229,.8); box-shadow:0 0 0 1px rgba(255,255,255,.7); pointer-events:none; position:absolute; }.marker { align-items:center; background:rgba(21,24,28,.15); border:2px solid var(--ink); border-radius:50%; display:flex; font-size:12px; font-weight:600; height:24px; justify-content:center; position:absolute; transform:translate(-50%,-50%); width:24px; }.marker.major { background:rgba(194,64,12,.25); border-color:var(--warn); color:var(--warn); }.marker.draft { background:rgba(79,70,229,.15); border:2px dashed var(--accent); color:var(--accent); }.image-label { bottom:10px; color:rgba(21,24,28,.5); font-size:12px; position:absolute; right:12px; }.scar-table { overflow:auto; }.scar-head,.scar-row { align-items:center; display:grid; gap:10px; grid-template-columns:.3fr 1.4fr 1fr .7fr 1fr .9fr .9fr; min-width:800px; }.scar-head { border-bottom:1px solid var(--line); color:rgba(21,24,28,.5); font-size:12px; font-weight:500; letter-spacing:.08em; padding:9px 14px; text-transform:uppercase; }.scar-row { border-bottom:1px solid rgba(21,24,28,.06); font-size:14px; min-height:44px; padding:9px 14px; }.scar-row b { font-weight:600; }.scar-row .warn,.scar-card .warn { color:var(--warn); }.draft-row { background:rgba(79,70,229,.04); color:var(--accent); }.draft-copy { grid-column:span 6; }.scar-cards { display:none; }.record-actions { align-items:center; display:flex; gap:16px; justify-content:space-between; }.record-actions p { font-size:12px; margin:0; }.record-actions > div,.form-actions > div { display:flex; gap:8px; }.record-actions form { margin:0; }.small-button { border:0; border-radius:8px; cursor:pointer; font-size:14px; min-height:44px; padding:8px 12px; }.small-button.secondary { background:#fff; border:1px solid var(--line-strong); }.small-button.finish { background:var(--accent); color:#fff; font-weight:500; }.scar-form { display:flex; flex-direction:column; gap:11px; min-width:0; padding:14px; }.form-heading { align-items:baseline; display:flex; gap:12px; justify-content:space-between; }.form-heading strong { font-size:15px; }.form-heading span { font-size:12px; }fieldset { border:0; display:flex; flex-direction:column; gap:5px; margin:0; min-width:0; padding:0; }legend,.notes > span { font-size:12px; font-weight:500; margin-bottom:5px; padding:0; }legend span { font-weight:400; }.chips { display:flex; flex-wrap:wrap; gap:6px; }.chip { align-items:center; border:1px solid var(--line-strong); border-radius:var(--radius-pill); cursor:pointer; display:inline-flex; font-size:12px; min-height:44px; padding:7px 12px; }.chip input { height:1px; min-height:0; opacity:0; position:absolute; width:1px; }.chip:has(input:checked) { background:var(--ink); border-color:var(--ink); color:#fff; }.chip.emphasis:not(:has(input:checked)) { border-color:var(--warn); color:var(--warn); }.chip i { border-radius:50%; height:12px; margin-right:6px; width:12px; }.chip span { display:inline; }.notes { display:flex; flex-direction:column; gap:5px; }.notes textarea,fieldset textarea { border:1px solid var(--line-strong); border-radius:8px; font-size:16px; min-height:44px; padding:8px 12px; resize:vertical; width:100%; }.form-actions { align-items:center; border-top:1px solid var(--line); display:flex; justify-content:space-between; padding-top:4px; }.form-actions > span { font-size:12px; }.small-button.save { background:var(--ink); color:#fff; font-weight:500; }.mobile-actions { display:none; }
  @media (max-width:1100px) { .entry-grid { grid-template-columns:1fr; }.scar-form { max-width:none; }.encounter-heading { align-items:flex-start; flex-direction:column; gap:8px; }.metadata { flex-wrap:wrap; }.record-actions { align-items:flex-start; flex-direction:column; gap:10px; } }
  @media (max-width:900px) { .scar-page { padding:14px 20px calc(88px + env(safe-area-inset-bottom)); }.entry-grid { grid-template-columns:1fr; }.photo-tabs > span:last-child { display:none; }.metadata .mono { display:none; }.scar-table,.record-actions { display:none; }.scar-cards { display:flex; flex-direction:column; gap:10px; }.scar-card { padding:14px; }.scar-card header { align-items:center; display:flex; gap:12px; justify-content:space-between; }.scar-card header span { background:var(--accent-soft); border-radius:var(--radius-pill); color:var(--accent); font-size:12px; padding:3px 8px; }.scar-card dl { display:flex; flex-direction:column; gap:7px; margin:12px 0 0; }.scar-card dl div { display:flex; font-size:14px; gap:16px; justify-content:space-between; }.scar-card dt { color:var(--muted); }.scar-card dd { margin:0; text-align:right; }.draft-card { background:var(--accent-soft); }.draft-card p { color:var(--muted); font-size:14px; margin:10px 0 0; }.scar-form { width:100%; }.form-actions { display:none; }.mobile-actions { align-items:center; background:rgba(255,255,255,.96); border-top:1px solid var(--line); bottom:0; display:grid; gap:10px; grid-template-columns:1fr 1fr; left:0; padding:10px 20px max(10px,env(safe-area-inset-bottom)); position:fixed; right:0; z-index:10; }.mobile-actions button { width:100%; } }
  @media (max-width:560px) { .scar-page { padding-inline:14px; }.encounter-heading { align-items:flex-start; flex-direction:column; gap:8px; }.metadata { align-items:flex-start; flex-direction:column; gap:4px; }.photo-tabs > span:first-child span { display:none; }.image-label { bottom:6px; left:8px; right:auto; }.form-heading { align-items:flex-start; flex-direction:column; gap:3px; }.scar-card dl div { align-items:flex-start; flex-direction:column; gap:2px; }.scar-card dd { text-align:left; }.mobile-actions { padding-inline:14px; } }
</style>
<script>
  const page = document.querySelector<HTMLElement>('.scar-page');
  const photo = document.querySelector<HTMLElement>('#scar-photo');
  const marker = document.querySelector<HTMLElement>('#draft-marker');
  const xInput = document.querySelector<HTMLInputElement>('#scar-x');
  const yInput = document.querySelector<HTMLInputElement>('#scar-y');
  const status = document.querySelector<HTMLElement>('#placed-status');
  photo?.addEventListener('click', (event) => {
    const bounds = photo.getBoundingClientRect();
    const x = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width));
    const y = Math.max(0, Math.min(1, (event.clientY - bounds.top) / bounds.height));
    if (marker && xInput && yInput) { marker.hidden=false; marker.style.left=`${x*100}%`; marker.style.top=`${y*100}%`; xInput.value=x.toFixed(5); yInput.value=y.toFixed(5); }
    if (status) status.textContent=page?.dataset.placementDone ?? '';
  });
  document.querySelector('#discard')?.addEventListener('click', () => { if(marker) marker.hidden=true; if(status) status.textContent=page?.dataset.placementPending ?? ''; });
</script>
