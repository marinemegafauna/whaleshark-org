---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicHeader from '../../components/PublicHeader.astro';
import PublicReportFields from '../../components/PublicReportFields.astro';
import { fillTemplate, getPageCopy } from '../../lib/content';
import { dataStore } from '../../lib/runtime';
import type { BatchItem } from '../../lib/db';
import { getSpecies } from '../../lib/species';
import { parseStoredPublicObservations } from '../../lib/public-observations';
import { isMockMode, publicWriteMode } from '../../lib/mode';

const copy = await getPageCopy('bulk');
const requestedBatchId = Astro.url.searchParams.get('batch');
const store = dataStore(Astro.locals);
const batch = requestedBatchId ? await store.getBatch(requestedBatchId) : null;
const species = getSpecies('whale-shark');
const batchObservations = parseStoredPublicObservations(batch?.observations_json);
const batchAnimalFieldIds = ['sex','life_stage','length','behavior','living_status','injury_severity','injury_regions','injury_types','injury_description'];
const diagnosticMode = !isMockMode() && publicWriteMode() === 'dry-run';
const sharedObservationError = Astro.url.searchParams.get('observation_error') === '1';
const items = batch ? await store.listBatchItems(batch.id) : [];
const totalBytes = items.reduce((sum, item) => sum + item.size_bytes, 0);
const finalStatuses = new Set(['matched', 'likely_new', 'no_shark', 'error']);
const completed = items.filter((item) => finalStatuses.has(item.status)).length;
const counts = {
  matched: items.filter((item) => item.status === 'matched').length,
  likelyNew: items.filter((item) => item.status === 'likely_new').length,
  noShark: items.filter((item) => item.status === 'no_shark').length,
  working: items.filter((item) => !finalStatuses.has(item.status)).length,
};
const folderAttributes = { webkitdirectory: true, directory: true };
function matchFor(item: BatchItem) {
  try { return JSON.parse(item.match_json ?? '{}') as Record<string, any>; } catch { return {}; }
}
function labelFor(item: BatchItem) {
  const match = matchFor(item);
  if (item.status === 'matched') return `${match.candidates?.[0]?.individualId ?? copy.statuses.matchedFallback} · ${Number(match.candidates?.[0]?.score ?? 0).toFixed(2)}`;
  if (item.status === 'likely_new') return fillTemplate(copy.statuses.likelyNew, { score: Number(match.score ?? 0).toFixed(2) });
  if (item.status === 'no_shark') return copy.statuses.noShark;
  if (item.status === 'error') return copy.statuses.error;
  if (item.status === 'matching') return copy.statuses.matching;
  if (item.status === 'detecting') return copy.statuses.detecting;
  if (item.status === 'uploading') return copy.statuses.uploading;
  return copy.statuses.queued;
}
const clientCopy = JSON.stringify({ summary: copy.summary, grid: copy.grid, statuses: copy.statuses, errors: copy.errors, batchCard: { dateSourcePhoto: copy.batchCard.dateSourcePhoto }, upload: { uploadedImageAlt: copy.upload.uploadedImageAlt } });
---
<BaseLayout title={copy.seo.title} description={copy.seo.description}>
  <PublicHeader active="match" />
  <main class="bulk-page" data-batch-id={batch?.id ?? ''} data-copy={clientCopy}>
    <section class="bulk-workspace">
      <div class="intro"><span>{copy.intro.eyebrow}</span><h1>{copy.intro.heading}</h1><p>{copy.intro.body}</p></div>
      {diagnosticMode && <p class="diagnostic-notice" role="status">{copy.intro.diagnosticNotice}</p>}

      <div class="card drop-zone" id="drop-zone">
        <input id="bulk-files" type="file" name="files" multiple accept="image/jpeg,image/heic,image/heif,image/tiff,.raw,.arw,.cr2,.cr3,.nef,.dng" />
        <div class="drop-intro"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4"></path><path d="M7 9l5-5 5 5"></path><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"></path></svg><div><strong>{copy.upload.dropHeading}</strong><span>{copy.upload.help}</span></div></div>
        <label class="choose-files" for="bulk-files">{copy.upload.choosePhotos}</label>
        <label class="choose-folder" for="bulk-folder">{copy.upload.chooseFolder}</label>
        <input id="bulk-folder" type="file" multiple {...folderAttributes} accept="image/jpeg,image/heic,image/heif,image/tiff,.raw,.arw,.cr2,.cr3,.nef,.dng" />
      </div>

      <div class="card summary" aria-live="polite">
        <div class="batch-size"><strong id="photo-count">{fillTemplate(copy.summary.photoCount, { count: items.length })}</strong><span id="total-size">{fillTemplate(copy.summary.size, { size: (totalBytes / 1_000_000).toFixed(totalBytes ? 1 : 0) })}</span></div>
        <div class="progress-wrap"><div class="progress" aria-hidden="true"><i id="progress-bar" style={`width:${items.length ? (completed / items.length) * 100 : 0}%`}></i></div><span class="mono" id="progress-label">{fillTemplate(copy.summary.progress, { complete: completed, total: items.length })}</span></div>
        <div class="legend"><span><i class="dot matched"></i>{copy.summary.matched} <b id="matched-count">{counts.matched}</b></span><span><i class="dot likely"></i>{copy.summary.likelyNew} <b id="new-count">{counts.likelyNew}</b></span><span><i class="dot none"></i>{copy.summary.noShark} <b id="none-count">{counts.noShark}</b></span><span><i class="dot working"></i>{copy.summary.working} <b id="working-count">{counts.working}</b></span></div>
      </div>

      <div class="photo-grid" id="photo-grid">
        {items.map((item) => { const match = matchFor(item); const bbox = Array.isArray(match.bbox) ? match.bbox : null; return <article class="tile"><div class="thumb"><img src={item.image_key} width="960" height="540" alt={copy.upload.uploadedImageAlt} />{bbox && <i class:list={['detect-box',{new:item.status === 'likely_new'}]} style={`left:${bbox[0]*100}%;top:${bbox[1]*100}%;width:${bbox[2]*100}%;height:${bbox[3]*100}%`}></i>}</div><div class="tile-meta"><span class:list={['status',item.status]}>{labelFor(item)}</span><span class="mono suffix">{item.filename.replace(/\.[^.]+$/, '').slice(-4)}</span></div></article> })}
      </div>
      <div class="grid-foot"><span id="grid-note">{items.length ? fillTemplate(copy.grid.grouped, { count: items.length }) : copy.grid.empty}</span><label for="bulk-files">{copy.grid.addMore}</label></div>
      <p class="upload-error" id="upload-error" role="alert"></p>
    </section>

    <aside class="card batch-card">
      <h2>{copy.batchCard.heading}</h2><p>{copy.batchCard.help}</p>
      <form id="batch-details">
        <div class="sighting-heading"><h3>{copy.batchCard.sightingHeading}</h3><p>{copy.batchCard.sightingHelp}</p><small id="date-source">{batch ? '' : copy.batchCard.dateSourcePending}</small></div>
        <PublicReportFields species={species} groups={['when_where','about_shark','water','about_you']} excludeFieldIds={batchAnimalFieldIds} values={batchObservations} compact />
        {sharedObservationError && <p class="shared-error" role="alert">{copy.errors.sharedDetails}</p>}
      </form>
      <div class="batch-totals"><span>{copy.batchCard.readyLabel} <b id="review-photo-count">{completed}</b></span><span>{copy.batchCard.publishNote}</span></div>
      <button class="button review-button" id="review-button" type="button" disabled={!batch || batch.status === 'draft'}>{copy.batchCard.reviewButton}</button>
      <p>{copy.batchCard.confirmationHelp}</p>
    </aside>
  </main>
</BaseLayout>
<style>
  .bulk-page { align-items:start; display:grid; gap:28px; grid-template-columns:minmax(0,1fr) 360px; padding:12px 64px 56px; }
  .bulk-workspace { display:flex; flex-direction:column; gap:16px; min-width:0; }
  .intro { display:flex; flex-direction:column; gap:6px; }
  .intro > span { color:var(--accent); font-size:13px; font-weight:500; }
  .intro h1 { font-size:36px; font-weight:600; letter-spacing:-.03em; line-height:1.05; margin:0; text-wrap:balance; }
  .intro p { color:var(--muted); font-size:15px; line-height:1.45; margin:0; max-width:900px; }
  .diagnostic-notice,.shared-error { background:var(--accent-soft); border-left:2px solid var(--accent); color:var(--muted); font-size:12px; line-height:1.45; margin:0; padding:9px 11px; }
  .shared-error { background:rgba(194,64,12,.08); border-left-color:var(--warn); color:var(--warn); }
  .drop-zone { align-items:center; border-style:dashed; display:flex; gap:16px; min-height:104px; padding:18px; position:relative; }
  .drop-zone.dragging { background:var(--accent-soft); border-color:var(--accent); }
  .drop-zone > input { height:1px; opacity:0; position:absolute; width:1px; }
  .drop-intro { align-items:center; display:flex; flex:1; gap:16px; min-width:0; }
  .drop-intro > div { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .drop-intro svg { color:var(--accent); flex:0 0 auto; }
  .drop-zone strong { font-size:14px; font-weight:600; }
  .drop-zone span { color:var(--muted); font-size:12px; }
  .choose-files,.choose-folder { align-items:center; border:1px solid var(--line-strong); border-radius:var(--radius-pill); cursor:pointer; display:inline-flex; font-size:14px; justify-content:center; min-height:44px; padding:0 16px; position:relative; }
  .choose-folder { background:var(--ink); border-color:var(--ink); color:#fff; }
  .summary { align-items:center; display:grid; font-size:14px; gap:18px; grid-template-columns:auto minmax(240px,1fr) auto; padding:14px 18px; }
  .batch-size { white-space:nowrap; }
  .batch-size span { color:var(--muted); }
  .progress-wrap { align-items:center; display:flex; gap:8px; min-width:0; }
  .progress { background:rgba(21,24,28,.08); border-radius:3px; flex:1; height:6px; overflow:hidden; }
  .progress i { background:var(--accent); display:block; height:100%; }
  .progress-wrap > span { font-size:12px; white-space:nowrap; }
  .legend { color:var(--muted); display:flex; font-size:12px; gap:14px; white-space:nowrap; }
  .legend span { align-items:center; display:flex; gap:5px; }
  .legend b { color:inherit; font-weight:500; }
  .dot { border-radius:50%; display:inline-block; height:8px; width:8px; }
  .dot.matched { background:var(--accent); }
  .dot.likely { background:var(--ink); }
  .dot.none { background:var(--warn); }
  .dot.working { background:rgba(21,24,28,.3); }
  .photo-grid { display:grid; gap:14px; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); }
  .tile { display:flex; flex-direction:column; gap:8px; min-width:0; }
  .thumb { background:repeating-linear-gradient(135deg,#e6e9ed 0 8px,#eef0f3 8px 16px); border-radius:8px; height:118px; overflow:hidden; position:relative; }
  .thumb img { height:100%; object-fit:cover; width:100%; }
  .detect-box { border:1.5px solid var(--accent); border-radius:3px; position:absolute; }
  .detect-box.new { border-color:var(--ink); }
  .tile-meta { align-items:center; display:flex; gap:8px; justify-content:space-between; min-width:0; }
  .status { align-items:center; background:rgba(21,24,28,.04); border-radius:999px; color:var(--muted); display:inline-flex; font-size:12px; font-weight:500; max-width:calc(100% - 42px); overflow:hidden; padding:3px 8px; text-overflow:ellipsis; white-space:nowrap; }
  .status.matched { background:rgba(79,70,229,.08); color:var(--accent); }
  .status.likely_new { background:rgba(21,24,28,.06); color:var(--ink); }
  .status.no_shark,.status.error { background:rgba(194,64,12,.08); color:var(--warn); }
  .suffix { color:var(--muted); flex:0 0 auto; font-size:12px; margin-left:auto; text-align:right; }
  .grid-foot { color:var(--muted); display:flex; font-size:14px; gap:16px; justify-content:space-between; }
  .grid-foot label { align-items:center; color:var(--ink); cursor:pointer; display:inline-flex; flex:0 0 auto; min-height:44px; text-decoration:underline; text-underline-offset:3px; }
  .upload-error { color:var(--warn); font-size:14px; margin:0; min-height:1em; }
  .batch-card { display:flex; flex-direction:column; gap:14px; padding:18px; }
  .batch-card h2 { font-size:15px; font-weight:600; margin:0; }
  .batch-card > p { color:var(--muted); font-size:12px; line-height:1.5; margin:0; }
  .batch-card form { display:flex; flex-direction:column; gap:14px; }
  .sighting-heading { border-top:1px solid var(--line); padding-top:14px; }.sighting-heading h3 { font-size:14px; margin:0; }.sighting-heading p { color:var(--muted); font-size:12px; line-height:1.45; margin:4px 0 0; }.sighting-heading small { color:var(--accent); display:block; font-size:11px; margin-top:4px; }
  .batch-card label { display:flex; flex-direction:column; font-size:12px; font-weight:500; gap:6px; }
  .batch-card small { color:var(--muted); font-size:12px; font-weight:400; }
  .batch-card input,.batch-card select { background:#fff; border:1px solid var(--line-strong); border-radius:8px; font-size:16px; min-height:44px; padding:10px 12px; width:100%; }
  .batch-totals { border-top:1px solid var(--line); display:flex; flex-direction:column; font-size:12px; gap:6px; padding-top:12px; }
  .batch-totals span { display:flex; justify-content:space-between; }
  .batch-totals span:last-child { color:var(--muted); }
  .review-button { min-height:44px; width:100%; }
  .review-button:disabled { cursor:not-allowed; opacity:.4; }
  @media (max-width:1180px) {
    .summary { grid-template-columns:auto minmax(0,1fr); }
    .legend { grid-column:1/-1; }
  }
  @media (max-width:900px) {
    .bulk-page { grid-template-columns:1fr; padding-inline:40px; }
    .batch-card { position:static; }
  }
  @media (max-width:560px) {
    .bulk-page { padding:8px 20px calc(40px + env(safe-area-inset-bottom)); }
    .intro h1 { font-size:32px; }
    .drop-zone { align-items:stretch; flex-direction:column; }
    .drop-intro { align-items:center; width:100%; }
    .choose-files,.choose-folder { width:100%; }
    .summary { gap:12px; grid-template-columns:auto minmax(0,1fr); padding:14px; }
    .legend { flex-wrap:wrap; grid-column:1/-1; row-gap:8px; white-space:normal; }
    .progress-wrap { justify-content:flex-end; }
    .progress { min-width:44px; }
    .thumb { height:132px; }
    .grid-foot { align-items:flex-start; flex-direction:column; }
    .review-button { bottom:max(12px,env(safe-area-inset-bottom)); box-shadow:0 8px 24px rgba(21,24,28,.22); position:sticky; z-index:2; }
  }
</style>
<script>
  import { fillTemplate } from '../../lib/content-utils';
  import { dateFromExif } from '../../lib/photo-date';
  type ApiItem = { id:string; filename:string; size_bytes:number; image_key:string; status:string; match_json:string|null };
  type EntryWithReader = FileSystemDirectoryEntry & { createReader(): FileSystemDirectoryReader };
  const page = document.querySelector<HTMLElement>('.bulk-page')!;
  const dropZone = document.querySelector<HTMLElement>('#drop-zone')!;
  const fileInput = document.querySelector<HTMLInputElement>('#bulk-files')!;
  const folderInput = document.querySelector<HTMLInputElement>('#bulk-folder')!;
  const details = document.querySelector<HTMLFormElement>('#batch-details')!;
  const grid = document.querySelector<HTMLElement>('#photo-grid')!;
  const reviewButton = document.querySelector<HTMLButtonElement>('#review-button')!;
  const errorBox = document.querySelector<HTMLElement>('#upload-error')!;
  const copy = JSON.parse(page.dataset.copy || '{}') as {
    summary: Record<string,string>; grid: Record<string,string>; statuses: Record<string,string>;
    errors: Record<string,string>; batchCard: { dateSourcePhoto:string }; upload: { uploadedImageAlt:string };
  };
  let batchId = page.dataset.batchId || '';
  let pollTimer = 0;
  const finalStatuses = new Set(['matched','likely_new','no_shark','error']);

  function parseMatch(item: ApiItem) { try { return JSON.parse(item.match_json || '{}'); } catch { return {}; } }
  function statusLabel(item: ApiItem) {
    const match = parseMatch(item);
    if (item.status === 'matched') return `${match.candidates?.[0]?.individualId || copy.statuses.matchedFallback} · ${Number(match.candidates?.[0]?.score || 0).toFixed(2)}`;
    if (item.status === 'likely_new') return fillTemplate(copy.statuses.likelyNew, { score: Number(match.score || 0).toFixed(2) });
    return { no_shark:copy.statuses.noShark, error:copy.statuses.error, matching:copy.statuses.matching, detecting:copy.statuses.detecting, uploading:copy.statuses.uploading, queued:copy.statuses.queued }[item.status] || item.status;
  }
  function updateSummary(items: ApiItem[]) {
    const complete = items.filter((item) => finalStatuses.has(item.status)).length;
    const total = items.reduce((sum,item) => sum + item.size_bytes, 0);
    document.querySelector('#photo-count')!.textContent = fillTemplate(copy.summary.photoCount, { count: items.length });
    document.querySelector('#total-size')!.textContent = fillTemplate(copy.summary.size, { size: (total / 1_000_000).toFixed(1) });
    (document.querySelector('#progress-bar') as HTMLElement).style.width = `${items.length ? complete / items.length * 100 : 0}%`;
    document.querySelector('#progress-label')!.textContent = fillTemplate(copy.summary.progress, { complete, total: items.length });
    document.querySelector('#matched-count')!.textContent = String(items.filter((item) => item.status === 'matched').length);
    document.querySelector('#new-count')!.textContent = String(items.filter((item) => item.status === 'likely_new').length);
    document.querySelector('#none-count')!.textContent = String(items.filter((item) => item.status === 'no_shark').length);
    document.querySelector('#working-count')!.textContent = String(items.length - complete);
    document.querySelector('#review-photo-count')!.textContent = String(complete);
    document.querySelector('#grid-note')!.textContent = items.length ? fillTemplate(copy.grid.grouped, { count: items.length }) : copy.grid.empty;
  }
  function render(items: ApiItem[], localUrls = new Map<string,string>()) {
    grid.replaceChildren(...items.map((item) => {
      const article = document.createElement('article'); article.className = 'tile';
      const thumb = document.createElement('div'); thumb.className = 'thumb';
      const image = document.createElement('img'); image.alt = copy.upload.uploadedImageAlt; image.src = localUrls.get(item.filename) || item.image_key; image.width=960; image.height=540; thumb.appendChild(image);
      const match = parseMatch(item); if (Array.isArray(match.bbox)) { const box=document.createElement('i'); box.className=`detect-box${item.status==='likely_new'?' new':''}`; box.style.cssText=`left:${match.bbox[0]*100}%;top:${match.bbox[1]*100}%;width:${match.bbox[2]*100}%;height:${match.bbox[3]*100}%`; thumb.appendChild(box); }
      const meta=document.createElement('div'); meta.className='tile-meta'; const status=document.createElement('span'); status.className=`status ${item.status}`; status.textContent=statusLabel(item); const suffix=document.createElement('span'); suffix.className='mono suffix'; suffix.textContent=item.filename.replace(/\.[^.]+$/,'').slice(-4); meta.appendChild(status); meta.appendChild(suffix); article.appendChild(thumb); article.appendChild(meta); return article;
    }));
    updateSummary(items);
  }
  async function poll() {
    if (!batchId) return;
    try {
      const response = await fetch(`/api/batches/${encodeURIComponent(batchId)}`);
      if (!response.ok) throw new Error();
      const payload = await response.json() as { batch:{ status:string }; items:ApiItem[] }; render(payload.items);
      const ready = payload.batch.status === 'review' || payload.batch.status === 'submitted';
      reviewButton.disabled = !ready; if (ready) return;
      pollTimer = window.setTimeout(poll, 700);
    } catch { errorBox.textContent = copy.errors.refresh; }
  }
  async function upload(files: File[]) {
    if (!files.length || !details.reportValidity()) return;
    errorBox.textContent=''; window.clearTimeout(pollTimer);
    const localUrls = new Map(files.map((file) => [file.name, URL.createObjectURL(file)]));
    render(files.map((file,index) => ({ id:`local-${index}`, filename:file.name, size_bytes:file.size, image_key:localUrls.get(file.name)!, status:'uploading', match_json:null })), localUrls);
    const exifDate = await dateFromExif(files[0]!); if (exifDate) { (details.elements.namedItem('observed_date') as HTMLInputElement).value=exifDate; document.querySelector('#date-source')!.textContent=copy.batchCard.dateSourcePhoto; }
    try {
      if (!batchId) {
        const metadata = Object.fromEntries(new FormData(details));
        const created = await fetch('/api/batches', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(metadata) });
        if (!created.ok) throw new Error(); const createdPayload=await created.json() as { batch:{ id:string } }; batchId=createdPayload.batch.id; page.dataset.batchId=batchId; history.replaceState({},'',`/bulk?batch=${encodeURIComponent(batchId)}`);
      } else {
        const metadata = Object.fromEntries(new FormData(details));
        const saved = await fetch(`/api/batches/${encodeURIComponent(batchId)}`, { method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify(metadata) });
        if (!saved.ok) throw new Error();
      }
      const form = new FormData(); files.forEach((file) => form.append('files',file,file.name));
      const response = await fetch(`/api/batches/${encodeURIComponent(batchId)}/items`, { method:'POST', body:form });
      if (!response.ok) throw new Error();
      await poll();
    } catch { errorBox.textContent=copy.errors.upload; }
  }
  function readEntry(entry: FileSystemEntry): Promise<File[]> {
    if (entry.isFile) return new Promise((resolve,reject) => (entry as FileSystemFileEntry).file((file) => resolve([file]),reject));
    return new Promise((resolve,reject) => { const reader=(entry as EntryWithReader).createReader(); const found:File[]=[]; const next=() => reader.readEntries(async (entries) => { if (!entries.length) return resolve(found); try { for (const child of entries) found.push(...await readEntry(child)); next(); } catch (error) { reject(error); } },reject); next(); });
  }
  async function droppedFiles(event: DragEvent) {
    const entries=[...(event.dataTransfer?.items || [])].map((item) => item.webkitGetAsEntry?.()).filter((entry):entry is FileSystemEntry => Boolean(entry));
    return entries.length ? (await Promise.all(entries.map(readEntry))).flat() : [...(event.dataTransfer?.files || [])];
  }
  for (const event of ['dragenter','dragover']) dropZone.addEventListener(event,(raw) => { raw.preventDefault(); dropZone.classList.add('dragging'); });
  for (const event of ['dragleave','drop']) dropZone.addEventListener(event,(raw) => { raw.preventDefault(); dropZone.classList.remove('dragging'); });
  dropZone.addEventListener('drop',async (event) => upload((await droppedFiles(event)).filter((file) => file.type.startsWith('image/') || /\.(raw|arw|cr2|cr3|nef|dng)$/i.test(file.name))));
  fileInput.addEventListener('change',() => upload([...(fileInput.files || [])])); folderInput.addEventListener('change',() => upload([...(folderInput.files || [])]));
  reviewButton.addEventListener('click',async () => {
    if (!batchId || !details.reportValidity()) return;
    const metadata = Object.fromEntries(new FormData(details));
    const saved = await fetch(`/api/batches/${encodeURIComponent(batchId)}`, { method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify(metadata) });
    if (!saved.ok) { errorBox.textContent=copy.errors.upload; return; }
    location.href=`/bulk/${encodeURIComponent(batchId)}/review`;
  });
  if (batchId) poll();
</script>
