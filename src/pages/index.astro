---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import siteConfig from '../../site.config';
import { resolveCatalogueStats } from '../lib/catalogue-stats';
import { catalogueDataStore, runtimeValue } from '../lib/runtime';

const catalogueStats = await resolveCatalogueStats({
  store: catalogueDataStore(Astro.locals),
  username: runtimeValue(Astro.locals, 'WILDBOOK_SERVICE_USER'),
  password: runtimeValue(Astro.locals, 'WILDBOOK_SERVICE_PASSWORD'),
  baseUrl: runtimeValue(Astro.locals, 'WILDBOOK_BASE_URL') ?? 'https://www.sharkbook.ai',
});
const countFormat = new Intl.NumberFormat('en-US');
const stats = [
  { value: countFormat.format(catalogueStats.whale_shark_individuals), label: 'Known whale sharks' },
  { value: countFormat.format(catalogueStats.whale_shark_encounters), label: 'Sightings on Sharkbook' },
  { value: countFormat.format(catalogueStats.whale_shark_encounters_ytd), label: `Sightings so far in ${new Date().getUTCFullYear()}` },
  { value: countFormat.format(catalogueStats.all_individuals), label: 'Sharks of all species on Sharkbook' },
];
const statsMonth = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  .format(new Date(catalogueStats.fetched_at));
const statsCaption = catalogueStats.source === 'live'
  ? 'live from sharkbook.ai'
  : `sharkbook.ai counts as of ${statsMonth}`;
const siteChips = [
  ...siteConfig.sites.map((site) => site.label),
  'Ningaloo',
  'Galápagos',
  'La Paz, Mexico',
  'Donsol',
  'Maldives',
];
---
<BaseLayout
  title="whaleshark.org · Help identify a whale shark"
  description="Upload a whale shark photo, find its Sharkbook match, and add a sighting to the global research record."
>
  <main>
    <PublicHeader />

    <section class="hero page-section">
      <div class="hero-copy">
        <p class="eyebrow">The community front door to Sharkbook</p>
        <h1>Every whale shark has a fingerprint. Help us read it.</h1>
        <p class="lede">
          The spots on a whale shark’s flank are unique for life. Photograph them and we can tell you which shark you met,
          where it has been seen before, and whether it’s new to science. Every photo joins the world’s largest shark
          photo-identification database.
        </p>
        <div class="hero-actions">
          <a class="button" href="#drop-photo">Drop a photo</a>
          <a class="button secondary" href="/bulk">Upload a whole dive</a>
          <a class="browse-link" href="https://www.sharkbook.ai">Browse the sharks</a>
        </div>
        <p class="hero-note">Free, no account needed. Your name stays on your photo.</p>
      </div>

      <div class="hero-visual">
        <figure class="hero-photo card">
          <img
            src="/landing/hero-whale-shark-mafia.jpg"
            width="1800"
            height="1351"
            alt="Whale shark swimming near the surface at Mafia Island, Tanzania"
          />
          <span class="detection-label mono">LEFT FLANK · MATCHED MZ-284 · 0.68</span>
          <span class="detection-box" aria-hidden="true"></span>
          <figcaption class="photo-caption mono">Marine Megafauna Foundation · Mafia Island</figcaption>
        </figure>
        <div class="live-match card">
          <img
            src="/landing/hero-whale-shark-mafia.jpg"
            width="1800"
            height="1351"
            alt="Detail of the matched whale shark’s spot pattern"
          />
          <div>
            <strong>MZ-284 · first seen Tofo, 2019</strong>
            <span>14 sightings · last seen 14 Aug 2026 · once at Mafia Island, 1,800 km away</span>
          </div>
          <span class="mono live-label">live match</span>
        </div>
      </div>
    </section>

    <section class="upload-section page-section" id="drop-photo" aria-labelledby="drop-heading">
      <form class="drop-zone card" action="/api/submit" method="post" enctype="multipart/form-data">
        <input
          id="photo"
          name="image"
          type="file"
          multiple
          accept="image/jpeg,image/heic,image/heif,image/png,image/tiff,.raw,.arw,.cr2,.cr3,.nef,.dng"
          required
        />
        <input type="hidden" name="photographer_name" value="Community photographer" />
        <input type="hidden" name="photographer_email" value="pending@example.org" />
        <input type="hidden" name="site_id" value="tofo" />
        <input type="hidden" name="observed_at" value="2026-08-14" />
        <div class="upload-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 16V4"></path><path d="M7 9l5-5 5 5"></path><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"></path>
          </svg>
        </div>
        <div class="drop-copy">
          <p class="eyebrow">Start with one clear image</p>
          <h2 id="drop-heading">Drop a left-flank photo here</h2>
          <p>or <span class="choose">choose a file</span> · JPEG, HEIC or RAW</p>
          <small>Your name stays on your photo. Nothing is published without you.</small>
        </div>
        <button class="button upload" type="submit">Compare my photo</button>
      </form>
      <p class="bulk-entry">Have a whole dive’s worth? <a href="/bulk">Bulk upload →</a></p>
    </section>

    <section class="stats-section page-section" id="catalogue" aria-label="Sharkbook catalogue statistics">
      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
      <p class="stats-caption mono">{statsCaption}</p>
    </section>

    <section class="why-section page-section">
      <div class="section-intro">
        <p class="eyebrow">Why it matters</p>
        <h2>Whale sharks are endangered. Photos are how we count them.</h2>
        <p class="lede">
          You can’t tag every shark in the ocean. But a photo of the spots behind the left gills identifies an animal for
          the rest of its life, without touching it. Enough photos, over enough years, and we can see what a population is doing.
        </p>
      </div>
      <div class="reason-grid">
        <article class="reason-card card">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 12c3-4 6-6 9-6s6 2 9 6c-3 4-6 6-9 6s-6-2-9-6z"></path><circle cx="12" cy="12" r="2.5"></circle>
          </svg>
          <h3>How many are there</h3>
          <p>Re-sightings of known sharks against new ones tell us population size and whether it is rising or falling at each site.</p>
        </article>
        <article class="reason-card card">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 17l5-5 4 4 7-8"></path><path d="M15 8h5v5"></path>
          </svg>
          <h3>Where they go</h3>
          <p>The same shark photographed in Mozambique and Tanzania is a movement record no satellite tag was needed for.</p>
        </article>
        <article class="reason-card card">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"></path><path d="M9 12l2 2 4-4"></path>
          </svg>
          <h3>What hurts them</h3>
          <p>Scars from propellers and nets, recorded to one standard at every site, show whether protection is working.</p>
        </article>
      </div>
    </section>

    <section class="how-section page-section">
      <div class="section-intro compact">
        <p class="eyebrow">How it works</p>
        <h2>Three steps, and you get the shark’s story back.</h2>
      </div>
      <div class="steps-grid">
        <article class="step">
          <figure class="step-image">
            <img
              src="/landing/step-photograph-left-side.jpg"
              width="1200"
              height="800"
              loading="lazy"
              alt="Diver photographing the left side of a whale shark behind its gills"
            />
            <figcaption class="photo-caption mono">PHOTO · left flank, spots visible · MMF</figcaption>
          </figure>
          <span class="step-number mono">01</span>
          <h3>Photograph the left side</h3>
          <p>Behind the gills, above the pectoral fin, as square-on as you can. Phone, GoPro or camera all work. Right side is a bonus.</p>
        </article>
        <article class="step">
          <figure class="step-image">
            <img
              src="/landing/step-spot-pattern.jpg"
              width="1200"
              height="801"
              loading="lazy"
              alt="Whale shark spot pattern behind the gills used for photo identification"
            />
            <span class="step-detection" aria-hidden="true"></span>
            <figcaption class="photo-caption mono">ILLUSTRATION · spot pattern to fingerprint</figcaption>
          </figure>
          <span class="step-number mono">02</span>
          <h3>We match the spots</h3>
          <p>Sharkbook’s algorithm compares your shark’s pattern with every known whale shark and ranks the closest matches with a confidence score.</p>
        </article>
        <article class="step">
          <div class="step-image screenshot-placeholder">
            <span class="photo-caption mono">SCREENSHOT · shark history page</span>
          </div>
          <span class="step-number mono">03</span>
          <h3>Researchers confirm it</h3>
          <p>The team at that site checks the match. You get the shark’s history, and an email every time it’s seen again.</p>
        </article>
      </div>
    </section>

    <section class="where-section page-section" id="sites">
      <figure class="where-photo">
        <img
          src="/landing/where-mafia-baitball.jpg"
          width="1400"
          height="1082"
          loading="lazy"
          alt="Whale shark feeding beneath a bait ball at Mafia Island, Tanzania"
        />
        <figcaption class="photo-caption mono">Mafia Island, Tanzania · MMF</figcaption>
      </figure>
      <div class="section-intro">
        <p class="eyebrow">Where the sharks are</p>
        <h2>One database, every ocean.</h2>
        <p class="lede">
          Sharkbook holds whale shark records from dozens of sites. whaleshark.org starts with the Western Indian Ocean
          network, where MMF and its partners run the season-by-season science.
        </p>
        <div class="chips" aria-label="Whale shark research sites">
          {siteChips.map((site) => <span class="chip">{site}</span>)}
          <span class="chip more">+ many more</span>
        </div>
      </div>
    </section>

    <section class="community-section page-section" id="photographers">
      <div class="community-card card">
        <div class="section-intro">
          <p class="eyebrow">A community resource</p>
          <h2>Built on Sharkbook. Stewarded by the Marine Megafauna Foundation. Open to everyone.</h2>
          <p class="lede">
            Sharkbook.ai is Wild Me’s open-source Wildbook platform for sharks — the world’s largest shark photo-ID database,
            built over two decades by thousands of contributors. whaleshark.org is a front door to it for whale sharks, and
            the code is open source so other species can have one too.
          </p>
        </div>
        <dl class="resource-list">
          <div><dt>Matching</dt><dd>Sharkbook.ai / Wild Me</dd></div>
          <div><dt>Stewardship</dt><dd>Marine Megafauna Foundation</dd></div>
          <div><dt>Your photos</dt><dd>Yours. Credited. Never sold.</dd></div>
          <div>
            <dt>Code</dt>
            <dd><a href="https://github.com/marinemegafauna/whaleshark-org">github.com/marinemegafauna/whaleshark-org</a></dd>
          </div>
        </dl>
      </div>
    </section>

    <footer id="about" class="mono">
      <span>whaleshark.org · a community resource stewarded by the Marine Megafauna Foundation</span>
      <nav aria-label="Legal and contact links"><span>Privacy</span><span>Data use</span><span>Contact</span></nav>
    </footer>
  </main>
</BaseLayout>

<style>
  main { min-height: 100vh; }
  img { display: block; max-width: 100%; }
  figure { margin: 0; }
  .page-section { margin-inline: auto; max-width: 1440px; padding-inline: 64px; }
  .eyebrow { color: var(--accent); font-size: 13px; font-weight: 500; letter-spacing: 0; margin: 0; text-transform: none; }
  .lede { color: rgba(21,24,28,.7); font-size: 17px; line-height: 1.55; margin: 0; text-wrap: pretty; }
  h1, h2, h3, p { margin-top: 0; }
  h2 { font-size: 34px; font-weight: 600; letter-spacing: -.03em; line-height: 1.1; margin-bottom: 0; text-wrap: balance; }

  .hero { align-items: center; display: grid; gap: 48px; grid-template-columns: minmax(0,1.05fr) minmax(0,1fr); padding-top: 36px; }
  .hero-copy, .hero-visual, .section-intro { display: flex; flex-direction: column; min-width: 0; }
  .hero-copy { gap: 20px; }
  .hero h1 { font-size: clamp(46px,4.35vw,62px); font-weight: 600; letter-spacing: -.04em; line-height: 1; margin: 0; overflow-wrap: normal; text-wrap: balance; word-break: normal; }
  .hero .lede { max-width: 560px; }
  .hero-actions { align-items: center; display: flex; flex-wrap: wrap; gap: 12px; }
  .browse-link { align-items:center; color:var(--muted); display:inline-flex; font-size:14px; margin-left:2px; min-height:44px; text-decoration:underline; text-underline-offset:3px; }
  .hero-note { color: var(--muted); font-size: 13px; margin: 0; }
  .hero-visual { gap: 12px; }
  .hero-photo { border-radius: 18px; height: 420px; overflow: hidden; position: relative; }
  .hero-photo > img { height: 100%; object-fit: cover; width: 100%; }
  .detection-box { border: 2px solid var(--accent); border-radius: 4px; height: 40%; left: 30%; position: absolute; top: 29%; width: 46%; }
  .detection-label { background: rgba(250,250,250,.88); color: var(--accent); font-size: 12px; left: 30%; padding: 3px 5px; position: absolute; top: 22%; }
  .photo-caption { background: rgba(250,250,250,.84); bottom: 12px; color: rgba(21,24,28,.72); font-size: 12px; left: 14px; letter-spacing: .03em; padding: 3px 5px; position: absolute; }
  .live-match { align-items: center; display: grid; gap: 14px; grid-template-columns: 64px minmax(0,1fr) auto; padding: 12px 14px; }
  .live-match img { border-radius: 6px; height: 46px; object-fit: cover; width: 64px; }
  .live-match div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .live-match strong { font-size: 14px; }
  .live-match div span { color: var(--muted); font-size: 12px; line-height: 1.35; }
  .live-label { color: var(--accent); font-size: 12px; }

  .upload-section { padding-top: 28px; }
  .drop-zone { align-items: center; border: 1.5px dashed rgba(21,24,28,.25); display: grid; gap: 24px; grid-template-columns: auto minmax(0,1fr) auto; min-height: 154px; overflow: hidden; padding: 28px 32px; position: relative; }
  .drop-zone input[type=file] { cursor: pointer; inset: 0; opacity: 0; position: absolute; z-index: 2; }
  .upload-icon { align-items: center; background: var(--accent-soft); border-radius: 50%; color: var(--accent); display: flex; height: 58px; justify-content: center; width: 58px; }
  .drop-copy { min-width: 0; }
  .drop-copy .eyebrow { margin-bottom: 6px; }
  .drop-copy h2 { font-size: 24px; margin-bottom: 5px; }
  .drop-copy p, .drop-copy small { color: var(--muted); display: block; font-size: 13px; margin: 0; }
  .drop-copy small { font-size: 12px; margin-top: 8px; }
  .choose { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .upload { opacity: 0; pointer-events: none; position: relative; z-index: 3; }
  .drop-zone:focus-within .upload, .drop-zone.has-file .upload { opacity: 1; pointer-events: auto; }
  .bulk-entry { color: var(--muted); font-size: 14px; margin: 10px 0 0; text-align: right; }
  .bulk-entry a { align-items:center; color:var(--ink); display:inline-flex; font-weight:600; min-height:44px; }

  .stats-section { padding-top: 52px; }
  .stats-grid { display: grid; gap: 28px; grid-template-columns: repeat(4,minmax(0,1fr)); }
  .stat { border-top: 1px solid rgba(21,24,28,.12); display: flex; flex-direction: column; gap: 4px; padding-top: 14px; }
  .stat strong { font-size: 34px; font-weight: 600; letter-spacing: -.03em; }
  .stat span { color: var(--muted); font-size: 13px; }
  .stats-caption { color: var(--muted); font-size: 12px; letter-spacing: .035em; margin: 12px 0 0; text-align: right; }

  .why-section { align-items: start; display: grid; gap: 56px; grid-template-columns: minmax(0,420px) minmax(0,1fr); padding-top: 96px; }
  .section-intro { gap: 14px; }
  .reason-grid { display: grid; gap: 20px; grid-template-columns: repeat(3,minmax(0,1fr)); }
  .reason-card { display: flex; flex-direction: column; gap: 12px; padding: 20px; }
  .reason-card h3, .step h3 { font-size: 18px; font-weight: 600; letter-spacing: -.01em; margin: 0; }
  .reason-card p, .step p { color: rgba(21,24,28,.65); font-size: 14px; line-height: 1.5; margin: 0; }

  .how-section { padding-top: 96px; }
  .section-intro.compact { gap: 10px; max-width: 640px; }
  .steps-grid { display: grid; gap: 20px; grid-template-columns: repeat(3,minmax(0,1fr)); margin-top: 28px; }
  .step { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .step-image { background: #e6e9ed; border-radius: 12px; height: 200px; overflow: hidden; position: relative; }
  .step-image img { height: 100%; object-fit: cover; width: 100%; }
  .step-detection { border: 2px solid var(--accent); border-radius: 4px; height: 50%; left: 16%; position: absolute; top: 25%; width: 52%; }
  .screenshot-placeholder { background: repeating-linear-gradient(135deg,#dfe3e8 0 10px,#e9ecf0 10px 20px); }
  .step-number { color: var(--accent); font-size: 12px; }

  .where-section { align-items: center; display: grid; gap: 48px; grid-template-columns: repeat(2,minmax(0,1fr)); padding-top: 96px; }
  .where-photo { border-radius: 18px; height: 360px; overflow: hidden; position: relative; }
  .where-photo img { height: 100%; object-fit: cover; width: 100%; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
  .chip { background: #fff; border: 1px solid rgba(21,24,28,.14); border-radius: 999px; font-size: 13px; padding: 8px 14px; }
  .chip.more { border-style: dashed; }

  .community-section { padding-top: 96px; }
  .community-card { align-items: center; border-radius: 18px; display: grid; gap: 40px; grid-template-columns: minmax(0,1.2fr) minmax(0,1fr); padding: 36px 40px; }
  .community-card h2 { font-size: 28px; }
  .community-card .lede { font-size: 15px; }
  .resource-list { font-size: 14px; margin: 0; }
  .resource-list div { display: grid; gap: 16px; grid-template-columns: auto minmax(0,1fr); padding: 10px 0; }
  .resource-list div:not(:last-child) { border-bottom: 1px solid var(--line); }
  .resource-list dt { color: var(--muted); }
  .resource-list dd { margin: 0; overflow-wrap: anywhere; text-align: right; }
  .resource-list a { align-items:center; display:inline-flex; min-height:44px; text-decoration:underline; text-underline-offset:3px; }

  footer { color: var(--muted); display: flex; font-size: 12px; gap: 32px; justify-content: space-between; margin-inline: auto; max-width: 1440px; padding: 56px 64px 40px; }
  footer nav { display: flex; gap: 24px; }

  @media (max-width: 900px) {
    .page-section { padding-inline: 32px; }
    .hero, .why-section, .where-section, .community-card { grid-template-columns: minmax(0,1fr); }
    .hero { padding-top: 28px; }
    .stats-grid, .reason-grid, .steps-grid { grid-template-columns: minmax(0,1fr); }
    .drop-zone { grid-template-columns: minmax(0,1fr); }
    .drop-zone .upload { grid-column: 1; justify-self: start; }
    .stats-grid { gap: 20px; }
    .why-section, .how-section, .where-section, .community-section { padding-top: 72px; }
    .where-photo { grid-row: 2; }
    footer { align-items: flex-start; flex-direction: column; padding-inline: 32px; }
  }

  @media (max-width: 560px) {
    .page-section { padding-inline: 20px; }
    .hero h1 { font-size: clamp(36px,10vw,46px); }
    .hero-photo { height: 320px; }
    .detection-label { left: 20px; top: 18px; }
    .detection-box { height: 39%; left: 28%; top: 31%; width: 54%; }
    .live-match { grid-template-columns: 64px minmax(0,1fr); }
    .live-label { grid-column: 2; }
    .drop-zone { gap: 16px; grid-template-columns: minmax(0,1fr); padding: 24px; }
    .drop-zone .upload { grid-column: 1; }
    .upload-icon { height: 48px; width: 48px; }
    .bulk-entry { text-align: left; }
    .why-section, .how-section, .where-section, .community-section { padding-top: 64px; }
    .community-card { padding: 28px 24px; }
    .resource-list div { grid-template-columns: minmax(0,1fr); gap: 4px; }
    .resource-list dd { text-align: left; }
    footer { padding: 48px 20px 32px; }
    footer nav { flex-wrap: wrap; }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('#photo');
  const zone = document.querySelector<HTMLFormElement>('.drop-zone');
  input?.addEventListener('change', async () => {
    const count = input.files?.length ?? 0;
    zone?.classList.toggle('has-file', count > 0);
    if (count > 1 && zone) {
      const button = zone.querySelector<HTMLButtonElement>('.upload');
      if (button) { button.textContent = 'Starting bulk upload…'; button.disabled = true; }
      try {
        const values = new FormData(zone);
        const metadata = Object.fromEntries([...values.entries()].filter(([,value]) => typeof value === 'string'));
        const created = await fetch('/api/batches', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(metadata) });
        if (!created.ok) throw new Error(await created.text());
        const payload = await created.json() as { batch:{ id:string } };
        const files = new FormData(); [...(input.files || [])].forEach((file) => files.append('files',file,file.name));
        const uploaded = await fetch(`/api/batches/${encodeURIComponent(payload.batch.id)}/items`, { method:'POST', body:files });
        if (!uploaded.ok) throw new Error(await uploaded.text());
        location.href = `/bulk?batch=${encodeURIComponent(payload.batch.id)}`;
      } catch {
        zone.action = '/api/batches';
        zone.requestSubmit();
      }
    } else if (zone) {
      zone.action = '/api/submit';
    }
  });
</script>
